{% set navRoute = app.request.attributes.get('_route')|default('') %}
{% set navSection = 'Votre espace' %}
{% set navTitle = 'Accueil' %}
{% set navHasExact = false %}
{% for section in navItems %}
 {% for item in section.children|default([section]) %}
  {% for child in item.children|default([item]) %}
   {% for link in child.children|default([child]) %}
    {% if link.route is defined and navRoute == link.route %}{% set navHasExact = true %}{% endif %}
    {% if link.route is defined and (navRoute == link.route or navRoute starts with link.prefix) and not (link.exclude is defined and navRoute starts with link.exclude) %}
     {% set navSection = section.label %}{% set navTitle = item.label %}
    {% endif %}
   {% endfor %}
  {% endfor %}
 {% endfor %}
{% endfor %}
