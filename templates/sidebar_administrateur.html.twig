{% import 'navigation/tree.html.twig' as navigation %}
<aside id="pf-sidebar" class="pf-sidebar" aria-label="Navigation principale" tabindex="-1">
 <div class="pf-brand-row">
  <a class="pf-brand" href="{{ path(canAdmin ? 'app_administrateur_fuel_dashboard' : 'app_workspace', canAdmin ? {entite: entite.id} : {}) }}">
   {% if entite.logo %}<span class="pf-brand-logo"><img src="{{ asset('uploads/photos/entite/logo/' ~ entite.logo) }}" alt="{{ entite.nom }}"></span>{% else %}<span class="pf-brand-monogram">{{ entite.nom|first }}</span>{% endif %}
   <span><strong>{{ entite.nom }}</strong><small>ESPACE DE GESTION</small></span>
  </a>
  <button type="button" class="pf-icon-button pf-sidebar-close" data-pf-close aria-label="Fermer le menu"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
 </div>
 <div class="pf-navigation-caption">VOTRE ACTIVITÉ</div>
 <nav class="pf-navigation">{{ navigation.tree(navItems, entite, navRoute, navHasExact) }}</nav>
 <div class="pf-sidebar-footer"><span class="pf-workspace-dot"></span><div><strong>{{ entite.nom }}</strong><small>Votre espace professionnel</small></div><i class="bi bi-shield-check" aria-hidden="true"></i></div>
</aside>
<button class="pf-sidebar-backdrop" data-pf-close aria-label="Fermer le menu" tabindex="-1" hidden></button>
