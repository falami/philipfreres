{# templates/base_admin.html.twig #}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta charset="UTF-8">
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <title>{% block title %}Bienvenue!{% endblock %}</title>
        {#<link rel="icon" type="image/x-icon" href="{{ asset('uploads/photos/entite/logo/')}}{{ entite.logo }}">#}
        <link rel="icon" type="image/x-icon" href="{{ asset('uploads/photos/entite/favicon/favicon-philip-freres.webp')}}">
        <!-- à mettre en haut du head -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

        <link rel="alternate" hreflang="fr" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale':'fr'})) }}">
        <link rel="alternate" hreflang="en" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale':'en'})) }}">
        <link rel="alternate" hreflang="x-default" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': app.request.locale == 'fr' ? 'en' : 'fr'})) }}">
        <meta property="og:locale" content="{{ app.request.locale == 'en' ? 'en_GB' : 'fr_FR' }}">
            
        <script src="{{ asset('dist/js/cookie-consent.js') }}"></script>

        {% block stylesheets %}

        {% endblock %}



        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

        {% block javascripts %}
        {% endblock %}

        {% if app.request.cookies.get('cookieConsent') == 'accepted' %}
            <!-- Google tag (gtag.js) -->
                <script async src="https://www.googletagmanager.com/gtag/js?id=G-1WB960CZ37"></script>
                <script>
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());

                gtag('config', 'G-1WB960CZ37');
                </script>
        {% endif %}

        
        <link rel="stylesheet" href="{{ asset('css/admin-navigation.css') }}?v=20261022-1">
        <script src="{{ asset('js/admin-navigation.js') }}?v=20261022-1" defer></script>
    </head>
    <body {% block body_attributes %}{% endblock %}>

        {% include '_cookie_consent.html.twig' %}


        {% include 'navigation/shell.html.twig' %}

        <main class="content" id="pf-main" tabindex="-1">
            {% block body %}
            {% endblock %}
        </main>

        <footer class="footer">
            &copy; 2025 - Philip Frères - <a href="#" id="manage-cookies" class="text-body text-decoration-none">Gérer les cookies</a>
        </footer>

        <button id="scrollToTopBtn" class="btn btn-warning rounded-circle shadow" title="Remonter">
            ↑
        </button>
        <script>
            const scrollBtn = document.getElementById("scrollToTopBtn");

            window.addEventListener("scroll", () => {
                if (window.scrollY > 200) {
                    scrollBtn.style.display = "block";
                } else {
                    scrollBtn.style.display = "none";
                }
            });

            scrollBtn.addEventListener("click", () => {
                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });
            });
            

        </script>
        {% block javascripts_bottom %}{% endblock %}
        
    </body>
</html>
