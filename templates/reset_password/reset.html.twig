{% extends 'security/_auth_layout.html.twig' %}
{% block title %}Nouveau mot de passe · Philip Frères{% endblock %}
{% block auth_progress %}<a class="auth-back-link" href="{{ path('app_login') }}"><span aria-hidden="true">←</span> Retour à la connexion</a>{% endblock %}
{% block auth_content %}
    <div class="auth-heading"><p class="auth-eyebrow">Un nouvel accès</p><h1>Choisissez votre<br>mot de passe.</h1><p id="password-help">Utilisez au moins 12 caractères, jusqu’à 128 : une phrase longue et unique, que vous n’utilisez sur aucun autre site.</p></div>
    {{ form_start(resetForm, {attr: {class: 'auth-form', 'data-auth-form': '', 'data-turbo': 'false'}}) }}
        {% if resetForm.vars.errors|length %}<div class="auth-field-errors" role="alert">{{ form_errors(resetForm) }}</div>{% endif %}
        {% for field in [resetForm.password.first, resetForm.password.second] %}
            <div class="auth-field">
                {{ form_label(field, loop.first ? 'Nouveau mot de passe' : 'Confirmer le mot de passe') }}
                <div class="auth-input-wrap auth-input-wrap--password">
                    <svg class="auth-icon auth-input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    {{ form_widget(field, {attr: {autocomplete: 'new-password', 'aria-describedby': 'password-help', minlength: 12, maxlength: 128}}) }}
                    <button type="button" class="auth-password-toggle" data-password-toggle aria-controls="{{ field.vars.id }}" aria-label="Afficher le mot de passe" aria-pressed="false" hidden><svg class="auth-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/><path class="auth-eye-slash" d="m4 3 16 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
                </div>
                {% if field.vars.errors|length %}<div class="auth-field-errors" role="alert">{{ form_errors(field) }}</div>{% endif %}
            </div>
        {% endfor %}
        <button class="auth-button" type="submit" data-submit-button><span data-submit-label>Enregistrer mon mot de passe</span><span class="auth-button-arrow" aria-hidden="true">→</span><span class="auth-spinner" aria-hidden="true" hidden></span></button>
        <p class="auth-form-caption">Vos appareils devront se reconnecter avec ce nouveau mot de passe et un code e-mail.</p>
    {{ form_end(resetForm) }}
{% endblock %}
