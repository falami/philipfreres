{% extends 'security/_auth_layout.html.twig' %}
{% block title %}Mot de passe oublié · Philip Frères{% endblock %}
{% block auth_progress %}<a class="auth-back-link" href="{{ path('app_login') }}"><span aria-hidden="true">←</span> Retour à la connexion</a>{% endblock %}
{% block auth_content %}
    <div class="auth-heading"><p class="auth-eyebrow">Retrouvez votre accès</p><h1>Un mot de passe<br>oublié ?</h1><p>Indiquez l’adresse e-mail de votre compte. Nous vous enverrons un lien pour choisir un nouveau mot de passe.</p></div>
    {{ form_start(requestForm, {attr: {class: 'auth-form', 'data-auth-form': '', 'data-turbo': 'false'}}) }}
        {% if requestForm.vars.errors|length %}<div class="auth-field-errors" role="alert">{{ form_errors(requestForm) }}</div>{% endif %}
        <div class="auth-field">
            {{ form_label(requestForm.email, 'Adresse e-mail') }}
            <div class="auth-input-wrap">
                <svg class="auth-icon auth-input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {{ form_widget(requestForm.email, {attr: {placeholder: 'prenom@entreprise.fr', autocomplete: 'email', autocapitalize: 'none', spellcheck: 'false', autofocus: true}}) }}
            </div>
            {% if requestForm.email.vars.errors|length %}<div class="auth-field-errors" role="alert">{{ form_errors(requestForm.email) }}</div>{% endif %}
        </div>
        <button class="auth-button" type="submit" data-submit-button><span data-submit-label>Recevoir mon lien</span><span class="auth-button-arrow" aria-hidden="true">→</span><span class="auth-spinner" aria-hidden="true" hidden></span></button>
        <p class="auth-form-caption">Le lien sera valable {{ ttlHuman|default('1 heure') }}.</p>
    {{ form_end(requestForm) }}
{% endblock %}
