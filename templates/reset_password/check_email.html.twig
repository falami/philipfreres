{% extends 'security/_auth_layout.html.twig' %}
{% block title %}Consultez votre boîte e-mail · Philip Frères{% endblock %}
{% block auth_progress %}<a class="auth-back-link" href="{{ path('app_login') }}"><span aria-hidden="true">←</span> Retour à la connexion</a>{% endblock %}
{% block auth_content %}
    <div class="auth-heading">
        <div class="auth-mail-mark" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><rect x="4" y="7" width="24" height="18" rx="4" stroke="currentColor" stroke-width="1.5"/><path d="m5 9 11 8L27 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <p class="auth-eyebrow">La suite, par e-mail</p><h1>Consultez votre<br>boîte e-mail.</h1><p>Si un compte correspond à cette adresse, un lien de réinitialisation vous a été envoyé.</p>
    </div>
    <div class="auth-notice">Ce lien est valable {{ ttlHuman|default('1 heure') }}. Il vous permettra de choisir un nouveau mot de passe.</div>
    <a href="{{ path('app_login') }}" class="auth-button">Retour à la connexion <span class="auth-button-arrow" aria-hidden="true">→</span></a>
    <div class="auth-resend"><p>Vous n’avez rien reçu ? <span>Vérifiez vos courriers indésirables et assurez-vous d’utiliser l’adresse de votre compte.</span></p><a class="auth-text-button" href="{{ path('app_forgot_password_request') }}">Faire une nouvelle demande</a></div>
{% endblock %}
