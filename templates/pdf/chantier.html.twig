{# templates/pdf/chantier.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <style>
    {# --- CONFIGURATION DES COULEURS --- #}
    {% set primary = entite.couleurPrincipal ?: '#1f3344' %}
    {% set secondary = entite.couleurSecondaire ?: '#f5b400' %}
    {% set light = '#f6f8fb' %}
    {% set border = '#d8dee8' %}
    {% set logoPath = entite.logo ? absolute_url(asset('uploads/photos/entite/logo/' ~ entite.logo)) : null %}
    {% set prestatairesAvecLogo = chantier.mandataires|filter(m => m.actif and m.logo)|slice(0, 3) %}

    {# --- VARIABLES DE SYNTHÈSE --- #}
    {% set totalHumains = chantier.nbRessourcesHumaines %}
    {% set totalEngins = chantier.nbRessourcesEngins %}
    {% set totalMateriels = chantier.nbRessourcesMateriels %}
    {% set totalDechets = chantier.nbDechets %}
    {% set totalPhotos = chantier.nbPhotos %}

    @page {
      margin: 24px 24px 42px 24px;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'DejaVu Sans', sans-serif;
      font-size: 10px;
      color: #1f2937;
      background: #fff;
    }

    {# --- FOOTER FIXE --- #}
    .footer {
      position: fixed;
      bottom: -30px;
      left: 0;
      right: 0;
      height: 30px;
      border-top: 1px solid #e5e7eb;
      padding-top: 5px;
      font-size: 8px;
      color: #6b7280;
    }

    {# --- STRUCTURES DE MISE EN PAGE --- #}
    .w-100 { width: 100%; }
    .text-center { text-align: center; }
    .text-right { text-align: right; }
    
    .page-break { page-break-before: always; }
    .keep-together { page-break-inside: avoid; }

    {# --- PAGE DE GARDE PREMIUM CORRIGÉE DOMPDF --- #}
.cover {
  height: 1074px;
  margin: -24px -24px -24px -24px;
  padding: 0;
  position: relative;
  background: {{ primary }};
  color: #fff;
  overflow: hidden;
}

.cover-band {
  height: 14px;
  background: {{ secondary }};
}

.cover-side {
  position: absolute;
  top: 14px;
  left: 0;
  bottom: 0;
  width: 72px;
  background: rgba(0,0,0,.16);
}

.cover-side-text {
  position: absolute;
  left: 18px;
  bottom: 96px;
  width: 42px;
  color: rgba(255,255,255,.45);
  font-size: 8px;
  line-height: 1.45;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.cover-watermark {
  position: absolute;
  right: -120px;
  top: 240px;
  font-size: 78px;
  line-height: .95;
  font-weight: bold;
  color: rgba(255,255,255,.035);
  text-transform: uppercase;
}

.cover-inner {
  padding: 20px 54px 0 120px;
  position: relative;
  z-index: 2;
}

.cover-header-table,
.cover-kpi-table,
.cover-footer-table {
  width: 100%;
  border-collapse: collapse;
}

.cover-header-table td,
.cover-kpi-table td,
.cover-footer-table td {
  border: 0;
  padding: 0;
  vertical-align: top;
}

.logo-box {
  width: 200px;
  height: 130px;
  background: #fff;
  border-radius: 14px;
  padding: 14px;
  text-align: center;
}

.logo-box img {
  max-width: 300px;
  max-height: 130px;
}

.logo-fallback {
  color: {{ primary }};
  font-size: 18px;
  font-weight: bold;
  padding-top: 45px;
  text-transform: uppercase;
}

.cover-ref-card {
  width: 300px;
  background: rgba(255,255,255,.09);
  border: 1px solid rgba(255,255,255,.25);
  padding: 14px 16px;
  text-align: right;
  border-radius: 14px;
}

.cover-ref-label {
  font-size: 7px;
  color: #cbd5e1;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 4px;
}

.cover-ref-value {
  font-size: 11px;
  color: #fff;
  font-weight: bold;
  line-height: 1.5;
  text-transform: uppercase;
}

.cover-status {
  display: inline-block;
  margin-top: 10px;
  padding: 5px 10px;
  background: #ffffff;
  color: {{ primary }};
  font-size: 8px;
  font-weight: bold;
  text-transform: uppercase;
}

.cover-category {
  margin-top: 50px;
  color: {{ secondary }};
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.cover-title {
  margin-top: 1px;
  width: 650px;
  font-size: 42px;
  line-height: 1.05;
  font-weight: bold;
  text-transform: uppercase;
}

.cover-title-small {
  display: block;
  margin-top: 8px;
  font-size: 20px;
  color: #dbeafe;
  font-weight: normal;
  letter-spacing: 1px;
}

.cover-rule {
  margin-top: 10px;
  width: 130px;
  height: 4px;
  background: {{ secondary }};
}

.cover-project {
  margin-top: 10px;
  width: 580px;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.20);
  padding: 16px 20px;
  border-radius: 14px;
}

.cover-project-label {
  font-size: 7px;
  color: #cbd5e1;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 8px;
}

.cover-project-name {
  font-size: 18px;
  font-weight: bold;
  line-height: 1.25;
  color: #fff;
}

.cover-project-saison-annee{
  font-size: 10px;
  font-weight: bold;
  line-height: 1.25;
  color: #fff;

}

.cover-project-address {
  margin-top: 10px;
  font-size: 9px;
  color: #dbeafe;
  line-height: 1.5;
}

.cover-kpi-table {
  margin-top: 26px;
  border-collapse: separate;
  border-spacing: 8px 0;
}

.cover-kpi-table + .cover-kpi-table {
  margin-top: 10px;
}

.cover-kpi-table td {
  width: 25%;
  height: 72px;
  background: rgba(255,255,255,.085);
  padding: 11px 12px;
  border-radius: 14px;
}

.cover-kpi-label {
  font-size: 6.5px;
  color: #cbd5e1;
  text-transform: uppercase;
  letter-spacing: .8px;
  margin-bottom: 6px;
}

.cover-kpi-value {
  font-size: 16px;
  font-weight: bold;
  color: #fff;
  line-height: 1.35;
  text-align: center;
}

.cover-signature {
  position: absolute;
  left: 120px;
  right: 54px;
  bottom: 10px;
  padding-top: 10px;
  border-top: 1px solid rgba(255,255,255,.22);
}

.cover-company {
  font-size: 12px;
  font-weight: bold;
  color: #fff;
}

.cover-contact {
  margin-top: 4px;
  font-size: 8px;
  color: #d1d5db;
  line-height: 1.45;
}

.cover-doc-type {
  text-align: right;
  font-size: 7px;
  color: #cbd5e1;
  text-transform: uppercase;
  letter-spacing: 1.2px;
}

.cover-page-mark {
  margin-top: 5px;
  font-size: 16px;
  color: {{ secondary }};
  font-weight: bold;
}

    {# --- TITRES ET SECTIONS --- #}
    h2 {
      margin: 20px 0 10px 0;
      padding-bottom: 6px;
      border-bottom: 2px solid {{ secondary }};
      color: {{ primary }};
      font-size: 13px;
      text-align: center;
      text-transform: uppercase;
    }

    h3 {
      margin: 15px 0 8px 0;
      padding: 6px 10px;
      background: #eef0f3;
      border-left: 5px solid {{ secondary }};
      color: {{ primary }};
      font-size: 10px;
      text-transform: uppercase;
    }

    {# --- TABLEAUX DE DONNÉES --- #}
    table { width: 100%; border-collapse: collapse; }
    
    .table-data { margin-bottom: 15px; }
    .table-data th, .table-data td {
      border: 1px solid {{ border }};
      padding: 7px;
      vertical-align: top;
    }

    .table-data th {
      background: #f0f2f5;
      color: #374151;
      font-size: 8px;
      text-transform: uppercase;
      text-align: center;
    }

    {# --- BLOCS KPI (SYNTHÈSE) --- #}
    .kpi-table { margin-bottom: 20px; border-spacing: 5px; border-collapse: separate; }
    .kpi-box {
      background: {{ light }};
      border: 1px solid {{ border }};
      border-top: 4px solid {{ secondary }};
      padding: 10px 5px;
      text-align: center;
      width: 20%;
    }
    .kpi-number { display: block; font-size: 18px; font-weight: bold; color: {{ primary }}; }
    .kpi-label { display: block; font-size: 7px; color: #6b7280; text-transform: uppercase; }

    {# --- SOMMAIRE (TOC) --- #}
    .toc-row td { border-top: 1px solid #e5e7eb; padding: 8px; }
    .toc-index { background: {{ light }}; color: {{ primary }}; font-weight: bold; width: 35px; text-align: center; }

    {# --- PHOTOS --- #}
    .photo-table { margin-bottom: 20px; table-layout: fixed; }
    .photo-cell {
      height: 520px;
      background: {{ light }};
      text-align: center;
      vertical-align: middle;
      border: 1px solid {{ border }};
    }
    .photo-cell img { max-width: 95%; max-height: 500px; border-radius: 2px; }
    .photo-meta { font-size: 8px; padding: 5px; color: #4b5563; }

    .badge {
      background: #fff7d6;
      border: 1px solid {{ secondary }};
      color: #8a5a00;
      padding: 2px 6px;
      font-weight: bold;
      text-transform: uppercase;
      font-size: 8px;
    }

    .map-cell {
      height: 170px;
      background: {{ light }};
      text-align: center;
      vertical-align: middle;
      border: 1px solid {{ border }};
    }

    .map-cell img {
      width: 95%;
      max-height: 160px;
      border: 1px solid {{ border }};
    }


    .cover-partners-box{
      padding: 0px 40px;

    }

    .cover-partners {

      margin-top: 10px;
      width: 500px;
      background: rgba(255,255,255,.08);
      border: 1px solid rgba(255,255,255,.22);
      border-radius: 16px;
      padding: 8px 14px;
    }

    .cover-partners-label {
      font-size: 7px;
      color: #cbd5e1;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      margin-bottom: 10px;
    }

    .cover-partner-logo {
        background: #fff;
        padding: 8px 8px;
        border-radius: 4px;
        display: inline-block;
    }

    .cover-partners-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 10px 0;
    }

    .cover-partners-table td {     
      border-radius: 14px;
      padding: 8px;
    }

    .cover-partners-table img {
      max-width: 150px;
      max-height: 58px;
      border-radius: 4px;
    }

    
  </style>
</head>
<body>

{# Footer répété sur chaque page #}
<div class="footer">
  <table class="w-100">
    <tr>
      <td>{{ entite.nom ?: 'Entité' }} - Compte rendu de chantier</td>
      <td class="text-right"></td>
    </tr>
  </table>
</div>

{# --- PAGE DE GARDE PREMIUM CORRIGÉE --- #}
<div class="cover">
  <div class="cover-band"></div>

  <div class="cover-side">
    <div class="cover-side-text">Rapport chantier</div>
  </div>

  <div class="cover-watermark">
    SUIVI<br>CHANTIER
  </div>

  <div class="cover-inner">
    <table class="cover-header-table">
      <tr>
        <td style="width: 50%;">
          <div class="logo-box">
            {% if logoPath %}
              <img src="{{ logoPath }}" alt="{{ entite.nom }}">
            {% else %}
              <div class="logo-fallback">{{ entite.nom ?: 'ENTITÉ' }}</div>
            {% endif %}
          </div>
        </td>

        <td style="width: 50%; text-align: right;">
          <div class="cover-ref-card">
            <div class="cover-ref-label">Rapport généré le</div>
            <div class="cover-ref-value">{{ "now"|date('d/m/Y') }}</div>
            {% if chantier.codeChantier %}
                <div class="cover-ref-label" style="margin-top:10px;">Code chantier</div>
                <div class="cover-ref-value">
                    {{ chantier.codeChantier }}
                </div>
            {% endif %}

            {% if chantier.nominationChantier %}
                <div class="cover-ref-label" style="margin-top:10px;">Nomination</div>
                <div class="cover-ref-value" style="font-size:9px; line-height:1.4;">
                    {{ chantier.nominationChantier }}
                </div>
            {% endif %}
          </div>
        </td>
      </tr>
    </table>

    {% if prestatairesAvecLogo|length > 0 %}
      <div class="cover-partners-box">
        <div class="cover-partners">
          <div class="cover-partners-label">Prestataires / Mandataires associés</div>

          <table class="cover-partners-table">
            <tr>
              {% for mandataire in prestatairesAvecLogo %}
                <td>
                  <div class="cover-partner-logo">
                    <img
                      src="{{ absolute_url(asset('uploads/mandataires/logos/' ~ mandataire.logo)) }}"
                      alt="{{ mandataire.societe ?: mandataire.nom }}"
                    >
                  </div>
                </td>
              {% endfor %}

              {% for i in prestatairesAvecLogo|length..2 %}
                {% if prestatairesAvecLogo|length < 3 %}
                  <td style="background: transparent;"></td>
                {% endif %}
              {% endfor %}
            </tr>
          </table>
        </div>
      </div>

      <div class="cover-category" style="margin-top: 15px;">
        Compte rendu d’intervention
      </div>
    {% else %}
      <div class="cover-category">
        Compte rendu d’intervention
      </div>
    {% endif %}


    <div class="cover-title">
      Rapport de chantier
      <span class="cover-title-small">Suivi opérationnel & reportage terrain</span>
    </div>

    <div class="cover-rule"></div>

    <div class="cover-project">
      <div class="cover-project-label">Chantier concerné</div>
      <div class="cover-project-name">{{ chantier.nom ?: '-' }}</div>
      <div class="cover-project-saison-annee">{% if chantier.saison %} Saison : {{ chantier.saison }}{% endif %}{% if chantier.annee %} - Année : {{ chantier.annee }}{% endif %}</div>

      <div class="cover-project-address">
        {{ chantier.adresse ?: '' }}
        {% if chantier.complement %}<br>{{ chantier.complement }}{% endif %}
        {% if chantier.codePostal or chantier.ville %}
          <br>{{ chantier.codePostal }} {{ chantier.ville }}
        {% endif %}
      </div>
    </div>

    <table class="cover-kpi-table">
      <tr>
        <td>
          <div class="cover-kpi-label">Période d'exécution</div>
          <div class="cover-kpi-value">{{ chantier.semaineReelle ?: '-' }}</div>
        </td>
        <td>
          <div class="cover-kpi-label">Date réelle</div>
          <div class="cover-kpi-value">
            {{ chantier.dateDebutReelle ? chantier.dateDebutReelle|date('d/m/Y') : '-' }}
            {% if chantier.dateFinReelle %}
              <br>{{ chantier.dateFinReelle|date('d/m/Y') }}
            {% endif %}
          </div>
        </td>
        <td>
          <div class="cover-kpi-label">Photos</div>
          <div class="cover-kpi-value">{{ totalPhotos }}</div>
        </td>
      </tr>
    </table>

    <table class="cover-kpi-table">
      <tr>
        <td>
          <div class="cover-kpi-label">Surface traitée</div>
          <div class="cover-kpi-value">{{ chantier.surfaceTotale ?: 0 }} m²</div>
        </td>
        <td>
          <div class="cover-kpi-label">Linéaire traité</div>
          <div class="cover-kpi-value">{{ chantier.lineaireTotal ?: 0 }} ml</div>
        </td>
        <td>
          <div class="cover-kpi-label">Déchets</div>
          <div class="cover-kpi-value">{{ totalDechets }}</div>
        </td>
      </tr>
    </table>


    <table class="cover-kpi-table">
      <tr>
        <td>
          <div class="cover-kpi-label">{% if totalHumains > 1 %}Ressources Humaines{% else %} Ressource Humaine {% endif %}</div>
          <div class="cover-kpi-value">{{ totalHumains }} </div>
        </td>
        <td>
          <div class="cover-kpi-label">{% if totalEngins > 1 %}Ressources vehicules{% else %} Ressource vehicule {% endif %}</div>
          <div class="cover-kpi-value">{{ totalEngins }}</div>
        </td>
        <td>
          <div class="cover-kpi-label">{% if totalEngins > 1 %}Ressources Matériel{% else %} Ressource matériels {% endif %}</div>
          <div class="cover-kpi-value">{{ totalMateriels }}</div>
        </td>
      </tr>
    </table>
  </div>

  <div class="cover-signature">
    <table class="cover-footer-table">
      <tr>
        <td style="width: 65%;">
          <div class="cover-company">{{ entite.nom ?: '-' }}</div>
          <div class="cover-contact">
            {% if entite.siret %}SIRET : {{ entite.siret }}<br>{% endif %}
            {{ entite.email ?: '' }}
            {% if entite.email and entite.telephone %} · {% endif %}
            {{ entite.telephone ?: '' }}
          </div>
        </td>

        <td style="width: 35%; text-align: right;">
          <div class="cover-doc-type">Document de synthèse</div>
          <div class="cover-page-mark">PDF</div>
        </td>
      </tr>
    </table>
  </div>
</div>

<div class="page-break"></div>

{# --- SYNTHÈSE --- #}
<h2>Synthèse du chantier</h2>

<table class="kpi-table w-100">
  <tr>
    <td class="kpi-box"><span class="kpi-number">{{ chantier.zones|length }}</span><span class="kpi-label">Zones</span></td>
    <td class="kpi-box"><span class="kpi-number">{{ totalHumains }}</span><span class="kpi-label">Humains</span></td>
    <td class="kpi-box"><span class="kpi-number">{{ totalEngins }}</span><span class="kpi-label">Engins</span></td>
    <td class="kpi-box"><span class="kpi-number">{{ totalMateriels }}</span><span class="kpi-label">Matériels</span></td>
    <td class="kpi-box"><span class="kpi-number">{{ totalPhotos }}</span><span class="kpi-label">Photos</span></td>
  </tr>
</table>

<table class="table-data w-100">
  <thead>
    <tr>
      <th>Chantier</th>
      <th>Ville</th>
      <th>Semaine</th>
      <th>Statut</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>{{ chantier.nom ?: '-' }}</td>
      <td>{{ chantier.ville ?: '-' }}</td>
      <td class="text-center">{{ chantier.semainePrevisionnelle ?: '-' }}</td>
      <td class="text-center"><span class="badge">{{ chantier.statut ? chantier.statut.label() : '-' }}</span></td>
    </tr>
  </tbody>
</table>

<table class="table-data w-100">
  <thead>
    <tr>
      <th>Début prév.</th>
      <th>Fin prév.</th>
      <th>Début réel</th>
      <th>Fin réelle</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td class="text-center">{{ chantier.dateDebutPrevisionnelle ? chantier.dateDebutPrevisionnelle|date('d/m/Y H:i') : '-' }}</td>
      <td class="text-center">{{ chantier.dateFinPrevisionnelle ? chantier.dateFinPrevisionnelle|date('d/m/Y H:i') : '-' }}</td>
      <td class="text-center">{{ chantier.dateDebutReelle ? chantier.dateDebutReelle|date('d/m/Y H:i') : '-' }}</td>
      <td class="text-center">{{ chantier.dateFinReelle ? chantier.dateFinReelle|date('d/m/Y H:i') : '-' }}</td>
    </tr>
  </tbody>
</table>



<table class="table-data w-100">
  <thead>
    <tr>
      <th>Durée prév.</th>
      <th>Durée réelle</th>
      <th>Surface tot.</th>
      <th>Linéaire tot.</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td class="text-center">
        {{ chantier.dureePrevisionnelleJoursOuvres ?? '-' }} j / {{ chantier.dureePrevisionnelleHeuresOuvrees ?? '-' }} h
      </td>

      <td class="text-center">
        {{ chantier.dureeReelleJoursOuvres ?? '-' }} j / {{ chantier.dureeReelleHeuresOuvrees ?? '-' }} h
      </td>
      <td class="text-center">{{ chantier.surfaceTotale ?: 0 }} m²</td>
      <td class="text-center">{{ chantier.lineaireTotal ?: 0 }} ml</td>
    </tr>
  </tbody>
</table>

{# --- SOMMAIRE --- #}
<div class="keep-together">
  <h2>Sommaire des sous-chantiers</h2>
  <table class="table-data">
    {% for zone in chantier.zones %}
      <tr class="toc-row">
        <td class="toc-index">{{ loop.index }}</td>
        <td>
          <strong>{{ zone.nom ?: 'Sous-chantier' }}</strong><br>
          <span style="font-size: 8px; color: #6b7280;">
            {% set infos = [] %}

            {% if zone.parcelle %}
                {% set infos = infos|merge(['Parcelle : ' ~ zone.parcelle]) %}
            {% endif %}

            {% if zone.surfaceTraitee and zone.surfaceTraitee > 0 %}
                {% set infos = infos|merge([zone.surfaceTraitee ~ ' m²']) %}
            {% endif %}

            {% if zone.lineaireTraite and zone.lineaireTraite > 0 %}
                {% set infos = infos|merge([zone.lineaireTraite ~ ' ml']) %}
            {% endif %}

            {% if zone.photos|length > 0 %}
                {% set infos = infos|merge([zone.photos|length ~ ' Photo' ~ (zone.photos|length > 1 ? 's' : '')]) %}
            {% endif %}

            {{ infos|join(' · ') }}
          </span>
        </td>
      </tr>
    {% else %}
      <tr><td colspan="2">Aucun sous-chantier renseigné.</td></tr>
    {% endfor %}
  </table>
</div>

{% if chantier.difficultesRencontrees %}
  <div class="keep-together">
    <h3>Difficultés générales rencontrées</h3>
    <div style="padding: 10px; border: 1px solid {{ border }}; line-height: 1.5;">
      {{ chantier.difficultesRencontrees|nl2br }}
    </div>
  </div>
{% endif %}

<div class="page-break"></div>

{# --- DÉTAIL DES ZONES --- #}
<h2>Détail des sous-chantiers</h2>

{% for zone in chantier.zones %}
  <div class="keep-together" style="margin-bottom: 30px; border: 1px solid {{ border }};">
    <div style="background: {{ primary }}; color: #fff; padding: 8px 10px; font-weight: bold;">
      {{ loop.index }}. {{ zone.nom ?: 'Sous-chantier' }}
    </div>
    
    <div style="padding: 10px;">
      <table class="table-data">
        <tr><th colspan="2">Nature de la prestation</th></tr>
        <tr><td colspan="2">{{ zone.naturePrestation ?: '-' }}</td></tr>
        <tr>
          <th>Période prév.</th>
          <td>
            {% if zone.dateDebutPrevisionnelle or zone.dateFinPrevisionnelle %}
                {% if zone.dateDebutPrevisionnelle %}
                    Du {{ zone.dateDebutPrevisionnelle|date('d/m/Y H:i') }}
                {% endif %}

                {% if zone.dateFinPrevisionnelle %}
                    {% if zone.dateDebutPrevisionnelle %} au {% else %}Jusqu'au {% endif %}
                    {{ zone.dateFinPrevisionnelle|date('d/m/Y H:i') }}
                {% endif %}
            {% endif %}
          </td>
        </tr>
        <tr>
          <th>Période réelle</th>
          <td>
            {% if zone.dateDebutReelle or zone.dateFinReelle %}
                {% if zone.dateDebutReelle %}
                    Du {{ zone.dateDebutReelle|date('d/m/Y H:i') }}
                {% endif %}

                {% if zone.dateFinReelle %}
                    {% if zone.dateDebutReelle %} au {% else %}Jusqu'au {% endif %}
                    {{ zone.dateFinReelle|date('d/m/Y H:i') }}
                {% endif %}
            {% endif %}
          </td>
        </tr>
      </table>

      <table class="table-data">
        <thead>
          <tr>
            <th>Humains</th>
            <th>Engins / Matériels</th>
            <th>Déchets</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              {% for r in zone.ressourcesHumaines %}
                • {{ r.utilisateur ? r.utilisateur.prenom ~ ' ' ~ r.utilisateur.nom : '-' }} <small>({{ r.fonction ?: '-' }})</small><br>
              {% else %}-{% endfor %}
            </td>
            <td>
              {% for r in zone.ressourcesEngins %}
                • {{ r.engin ? r.engin.nom : '-' }} <small>(Engin)</small><br>
              {% endfor %}
              {% for r in zone.ressourcesMateriels %}
                • {{ r.materiel ? r.materiel.nom : '-' }} <small>(x{{ r.quantite ?: 1 }})</small><br>
              {% endfor %}
              {% if zone.ressourcesEngins|length == 0 and zone.ressourcesMateriels|length == 0 %}-{% endif %}
            </td>
            <td>
              {% for d in zone.dechets %}
                • {{ d.quantite }} {{ d.typeDechet ? d.typeDechet.unite : '' }} ({{ d.typeDechet ? d.typeDechet.nom : '-' }})<br>
              {% else %}-{% endfor %}
            </td>
          </tr>
        </tbody>
      </table>

      {% if zone.difficultesRencontrees %}
        <div style="font-size: 8px; color: #d32f2f; margin-top: 5px;">
          <strong>Difficultés :</strong> {{ zone.difficultesRencontrees }}
        </div>
      {% endif %}
    </div>
  </div>
{% endfor %}




{% if chantier.tableauDynamique and chantier.tableauDynamique.columns is defined and chantier.tableauDynamique.rows is defined %}
  <div class="page-break"></div>
  <div class="keep-together">
    <h2>Bilan récapitulatif chantier</h2>

    <table class="table-data w-100">
      <thead>
        <tr>
          {% for col in chantier.tableauDynamique.columns %}
            <th>{{ col }}</th>
          {% endfor %}
        </tr>
      </thead>

      <tbody>
        {% for row in chantier.tableauDynamique.rows %}
          <tr>
            {% for cell in row %}
              <td>{{ cell ?: '-' }}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}

<div class="page-break"></div>

{# --- REPORTAGE PHOTOS --- #}
<h2>Reportage photos avant / après</h2>

{% set hasAnyPhoto = false %}
{% for zone in chantier.zones %}
  {% for p in zone.photos %}
    {% set hasAnyPhoto = true %}
    <div class="keep-together">
      <h3>{{ zone.nom }} {% if p.titre %}- {{ p.titre }}{% endif %}</h3>
      
      <table class="photo-table w-100">
        <tr>
            <th style="background: {{ primary }}; color: #fff;">
                Avant intervention
            </th>

            <th style="background: {{ primary }}; color: #fff;">
                Après intervention
            </th>
        </tr>

        <tr>
            <td class="photo-cell">
                {% if p.photoAvant %}
                    <img src="{{ absolute_url(asset('uploads/photos/chantiers/' ~ p.photoAvant)) }}">
                {% else %}
                    <span style="color:#9ca3af;font-style:italic;">
                        Champ non renseigné
                    </span>
                {% endif %}
            </td>

            <td class="photo-cell">
                {% if p.photoApres %}
                    <img src="{{ absolute_url(asset('uploads/photos/chantiers/' ~ p.photoApres)) }}">
                {% else %}
                    <span style="color:#9ca3af;font-style:italic;">
                        Champ non renseigné
                    </span>
                {% endif %}
            </td>
        </tr>

        <tr>
            <td class="map-cell">
                {% set mapAvant = photoMaps[p.id].avant ?? null %}

                {% if mapAvant %}
                    <img src="{{ mapAvant }}" alt="Carte photo avant">
                {% else %}
                    <span style="color:#9ca3af;font-style:italic;">
                        Champ non renseigné
                    </span>
                {% endif %}
            </td>

            <td class="map-cell">
                {% set mapApres = photoMaps[p.id].apres ?? null %}

                {% if p.photoApres and mapApres %}
                    <img src="{{ mapApres }}" alt="Carte photo après">
                {% else %}
                    <span style="color:#9ca3af;font-style:italic;">
                        Champ non renseigné
                    </span>
                {% endif %}
            </td>
        </tr>

        <tr>
            <td class="photo-meta">
                <strong>Date :</strong>
                {{ p.datePriseVueAvant ? p.datePriseVueAvant|date('d/m/Y') : 'Champ non renseigné' }}
                <br>

                <strong>Adresse :</strong>
                {{ p.adresseAvant ?: 'Champ non renseigné' }}
                <br>

                <strong>GPS :</strong>
                {{ p.latitudeAvant and p.longitudeAvant
                    ? p.latitudeAvant ~ ', ' ~ p.longitudeAvant
                    : 'Champ non renseigné'
                }}
            </td>

            <td class="photo-meta">

              {% if p.photoApres %}

                  <strong>Date :</strong>
                  {{ p.datePriseVueApres ? p.datePriseVueApres|date('d/m/Y') : 'Champ non renseigné' }}
                  <br>

                  <strong>Adresse :</strong>
                  {{ p.adresseApres ?: 'Champ non renseigné' }}
                  <br>

                  <strong>Latitude / Longitude :</strong>

                  {% if p.latitudeApres is not null and p.longitudeApres is not null %}
                      {{ p.latitudeApres }}, {{ p.longitudeApres }}
                  {% else %}
                      Champ non renseigné
                  {% endif %}

              {% else %}

                  <strong>Date :</strong>
                  <span style="color:#9ca3af;font-style:italic;">
                      Champ non renseigné
                  </span>
                  <br>

                  <strong>Adresse :</strong>
                  <span style="color:#9ca3af;font-style:italic;">
                      Champ non renseigné
                  </span>
                  <br>

                  <strong>Latitude / Longitude :</strong>
                  <span style="color:#9ca3af;font-style:italic;">
                      Champ non renseigné
                  </span>

              {% endif %}

          </td>
        </tr>

        {% if p.commentaire %}
            <tr>
                <td colspan="2"
                    style="border:1px solid {{ border }};padding:8px;font-style:italic;">
                    <strong>Note :</strong> {{ p.commentaire }}
                </td>
            </tr>
        {% endif %}
    </table>
    </div>
  {% endfor %}
{% endfor %}



{% if not hasAnyPhoto %}
  <div style="text-align: center; padding: 40px; border: 1px solid {{ border }};">Aucune photo enregistrée pour ce chantier.</div>
{% endif %}

</body>
</html>