{# templates/administrateur/carburant/_calendar_common.html.twig #}

<header class="calendar-intro">
  <div>
    <div class="calendar-eyebrow"><span></span> {{ entite.nom }} · Suivi des dépenses</div>
    <h1>{{ activeTab == 'engin' ? 'Votre parc, en perspective.' : (activeTab == 'employe' ? 'Vos équipes, au quotidien.' : 'Une vue d’ensemble.') }}<br><em>Chaque jour compte.</em></h1>
    <p>{{ activeTab == 'global' ? 'Retrouvez vos dépenses et explorez le détail de chaque journée.' : (activeTab == 'engin' ? 'Suivez les dépenses de chaque engin, jour après jour.' : 'Retrouvez les dépenses de chaque collaborateur, jour après jour.') }}</p>
  </div>
  <div class="calendar-intro-icon" aria-hidden="true"><i class="bi bi-calendar2-week"></i></div>
</header>
<div class="calendar-section-heading">
  <div><h2>Calendrier des dépenses{{ activeTab == 'engin' ? ' par engin' : (activeTab == 'employe' ? ' par employé' : '') }}</h2><p>Choisissez votre perspective.</p></div>
  <nav class="calendar-perspectives" aria-label="Vue des dépenses">
    <a {% if activeTab == 'global' %}aria-current="page"{% endif %} href="{{ path('app_administrateur_fuel_calendar_global', {entite: entite.id}) }}"><i class="bi bi-grid-1x2"></i> Global</a>
    <a {% if activeTab == 'engin' %}aria-current="page"{% endif %} href="{{ path('app_administrateur_fuel_calendar_engin', {entite: entite.id}) }}"><i class="bi bi-truck-front"></i> Par engin</a>
    <a {% if activeTab == 'employe' %}aria-current="page"{% endif %} href="{{ path('app_administrateur_fuel_calendar_employe', {entite: entite.id}) }}"><i class="bi bi-people"></i> Par employé</a>
  </nav>
</div>
<section class="calendar-metrics" aria-label="Totaux de la période affichée">
  <article class="calendar-metric calendar-metric-primary"><div><span>Dépenses TTC</span><strong id="sumAmount">—</strong><small>Période affichée</small></div><i class="bi bi-wallet2" aria-hidden="true"></i></article>
  <article class="calendar-metric"><div><span>Transactions</span><strong id="sumCnt">—</strong><small>Tous fournisseurs confondus</small></div><i class="bi bi-receipt" aria-hidden="true"></i></article>
  <article class="calendar-metric"><div><span>Quantité totale</span><strong id="sumQty">—</strong><small>Période affichée</small></div><i class="bi bi-droplet" aria-hidden="true"></i></article>
</section>
{% if activeTab in ['engin', 'employe'] %}
<section class="calendar-scope" aria-label="Sélection {{ activeTab == 'engin' ? 'de l’engin' : 'de l’employé' }}">
  <div class="calendar-scope-heading">
    <i class="bi {{ activeTab == 'engin' ? 'bi-truck-front' : 'bi-person' }}" aria-hidden="true"></i>
    <div><label for="scopeSelect">{{ activeTab == 'engin' ? 'Choisir un engin' : 'Choisir un employé' }}</label>
    <p>Les indicateurs et le calendrier suivent votre sélection.</p></div>
  </div>
  <div class="calendar-scope-control">
    <select id="scopeSelect" class="form-select js-tomselect-scope"
            data-placeholder="{{ activeTab == 'engin' ? 'Rechercher un engin…' : 'Rechercher un employé…' }}">
      <option value="">{{ activeTab == 'engin' ? 'Sélectionnez un engin…' : 'Sélectionnez un employé…' }}</option>
      {% if activeTab == 'engin' %}
        {% for e in engins %}<option value="{{ e.id }}">{{ e.nom }}</option>{% endfor %}
      {% else %}
        {% for u in employes %}<option value="{{ u.id }}">{{ u.prenom }} {{ u.nom }}</option>{% endfor %}
      {% endif %}
    </select>
  </div>
</section>
{% endif %}

{# ✅ Toujours présent (sinon ton JS casse en global) #}
<input type="hidden" id="fStart" value="{{ start }}">
<input type="hidden" id="fEnd" value="{{ end }}">
<input type="text" class="d-none" id="fRange" />

{# ===== CALENDAR CARD ===== #}
<div class="calendar-card p-3">
  <div id="calendarSelectionHint" class="calendar-selection-hint" {% if activeTab == 'global' %}hidden{% endif %}>
    <i class="bi bi-info-circle" aria-hidden="true"></i>
    {{ activeTab == 'engin' ? 'Choisissez un engin dans la liste ci-dessus pour afficher ses dépenses.' : 'Choisissez un employé dans la liste ci-dessus pour afficher ses dépenses.' }}
  </div>
  <div id="calendar"></div>
  <div class="calendar-footnote"><span><span class="calendar-today-dot"></span> Aujourd’hui</span><span id="calendarStatus" role="status" aria-live="polite">Chargement des dépenses…</span></div>
</div>

{# ===== MODAL (click event) ===== #}
<div class="modal fade" id="fuelDayModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content" style="border-radius:18px; overflow:hidden;">
      <div class="modal-header" style="background: linear-gradient(135deg, var(--theme-color-principal), var(--theme-color-secondaire)); color:#fff;">
        <div>
          <h5 class="modal-title mb-0 fw-bold">Détails dépenses</h5>
          <div class="small opacity-75" id="fuelDayModalSub">-</div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>

      <div class="modal-body">
        <div id="fuelDayModalBody">
          <div class="text-muted small">Chargement…</div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>