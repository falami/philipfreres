{# templates/administrateur/calendrier/index.html.twig #}
{% extends 'base_admin.html.twig' %}

{% block title %}Planning ressources{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">

  <style>
    :root{
  --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
  --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
  --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
  --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};

  --bg:#f3f6fb;
  --panel:#ffffff;
  --ink:#0f172a;
  --muted:#64748b;

  --stroke:rgba(15,23,42,.08);
  --stroke-strong:rgba(15,23,42,.14);

  --shadow-xs:0 2px 6px rgba(15,23,42,.04);
  --shadow-sm:0 10px 25px rgba(15,23,42,.06);
  --shadow-md:0 18px 50px rgba(15,23,42,.10);
  --shadow-xl:0 30px 80px rgba(15,23,42,.16);

  --radius:24px;

  --cell-w:96px;
  --col-resource:300px;
  --col-meta:220px;
}

body{
  background:
    radial-gradient(1200px 480px at 0% -10%, color-mix(in srgb, var(--theme-color-secondaire) 14%, transparent), transparent 60%),
    radial-gradient(1200px 480px at 100% 0%, color-mix(in srgb, var(--theme-color-principal) 14%, transparent), transparent 60%),
    linear-gradient(180deg,#f8fbff 0%,#f3f6fb 100%);
}

/* HERO */

.hero{
  position:relative;
  overflow:hidden;
  border-radius:32px;
  padding:2rem !important;
  color:#fff;

  background:
    radial-gradient(900px 380px at 0% 0%, rgba(255,255,255,.18), transparent 60%),
    radial-gradient(700px 280px at 100% 0%, rgba(255,255,255,.12), transparent 60%),
    linear-gradient(135deg,
      color-mix(in srgb, var(--theme-color-principal) 92%, #000 8%),
      color-mix(in srgb, var(--theme-color-principal) 58%, var(--theme-color-secondaire) 42%)
    );

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.18),
    0 30px 70px rgba(15,23,42,.22);
}

.hero::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(180deg, rgba(255,255,255,.10), transparent 45%);
  pointer-events:none;
}

.hero .accent{
  width:14px;
  border-radius:999px;
  background:#fff;
  opacity:.9;
  box-shadow:0 0 0 8px rgba(255,255,255,.10);
}

.hero h2{
  font-size:2rem;
  letter-spacing:-.03em;
  font-weight:950;
}

.hero-chip{
  display:inline-flex;
  align-items:center;
  gap:.45rem;

  padding:.45rem .85rem;

  border-radius:999px;

  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.16);

  color:#fff;
  font-size:.78rem;
  font-weight:850;

  backdrop-filter:blur(10px);
}

/* TOOLBAR */

.toolbar{
  position:sticky;
  top:.75rem;
  z-index:40;

  border-radius:26px;

  background:rgba(255,255,255,.70);
  backdrop-filter:blur(20px);

  border:1px solid rgba(255,255,255,.7);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.85),
    var(--shadow-md);

  padding:.9rem 1rem;
}

.toolbar-grid{
  display:grid;
  grid-template-columns:1.3fr 1fr 1fr 1fr auto;
  gap:12px;
  align-items:end;
}

.f-item,
.f-item-lg{
  grid-column:auto;
}

.form-label{
  font-size:.68rem;
  font-weight:950;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--muted);
  margin-bottom:.35rem;
}

/* INPUTS */

.form-control,
.form-select,
.ts-control{
  min-height:42px !important;
  height:42px !important;

  border-radius:15px !important;

  border:1px solid rgba(15,23,42,.08) !important;

  background:
    linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,252,.96)) !important;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.95),
    0 1px 2px rgba(15,23,42,.04) !important;

  color:var(--ink) !important;

  font-size:.88rem !important;
  font-weight:700;
}

.form-control:focus,
.form-select:focus,
.ts-control.focus{
  border-color:color-mix(in srgb, var(--theme-color-principal) 30%, #fff) !important;

  box-shadow:
    0 0 0 4px color-mix(in srgb, var(--theme-color-principal) 10%, transparent),
    inset 0 1px 0 rgba(255,255,255,.95) !important;
}

.ts-wrapper.multi .ts-control{
  min-height:42px !important;
  max-height:42px !important;
  overflow:hidden;
  padding-top:4px !important;
  padding-bottom:4px !important;
}

.ts-wrapper .ts-control > div{
  border-radius:999px !important;

  background:
    color-mix(in srgb, var(--theme-color-principal) 8%, #fff) !important;

  border:1px solid
    color-mix(in srgb, var(--theme-color-principal) 12%, #fff) !important;

  font-size:.72rem !important;
  font-weight:850 !important;

  padding:.15rem .5rem !important;

  max-width:130px;

  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.ts-dropdown{
  border-radius:18px !important;
  overflow:hidden;

  border:1px solid var(--stroke) !important;

  box-shadow:var(--shadow-xl) !important;
}

/* BUTTONS */

.toolbar-actions{
  display:flex;
  gap:10px;
  align-items:center;
  white-space:nowrap;
}

.btn-premium,
.btn-outline-soft{
  min-height:42px;
  height:42px;

  border-radius:15px;

  font-size:.84rem;
  font-weight:950;

  padding:0 1rem;

  transition:.18s ease;
}

.btn-premium{
  border:0;

  color:#fff;

  background:
    linear-gradient(135deg,
      color-mix(in srgb, var(--theme-color-principal) 92%, #000 8%),
      color-mix(in srgb, var(--theme-color-principal) 55%, var(--theme-color-secondaire) 45%)
    );

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.14),
    0 14px 28px rgba(15,23,42,.18);
}

.btn-outline-soft{
  border:1px solid rgba(15,23,42,.08);

  background:rgba(255,255,255,.82);

  color:var(--ink);

  box-shadow:var(--shadow-xs);
}

.btn-premium:hover,
.btn-outline-soft:hover{
  transform:translateY(-2px);
}

/* KPI */

.kpis{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:16px;
}

.kpi{
  position:relative;

  overflow:hidden;

  border-radius:24px;

  padding:1rem 1.1rem;

  background:
    linear-gradient(180deg, rgba(255,255,255,.96), rgba(248,250,252,.96));

  border:1px solid rgba(255,255,255,.85);

  box-shadow:var(--shadow-sm);
}

.kpi::before{
  content:"";
  position:absolute;
  inset:0 auto 0 0;
  width:4px;

  background:
    linear-gradient(180deg,
      var(--theme-color-secondaire),
      var(--theme-color-principal));
}

.kpi .label{
  color:var(--muted);
  font-size:.78rem;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.05em;
}

.kpi .value{
  margin-top:.35rem;

  color:var(--ink);

  font-size:1.4rem;
  font-weight:950;

  letter-spacing:-.03em;
}

/* TABLE */

.cardx{
  overflow:hidden;

  border-radius:30px;

  background:rgba(255,255,255,.78);

  backdrop-filter:blur(18px);

  border:1px solid rgba(255,255,255,.72);

  box-shadow:var(--shadow-xl);
}

.cardx-h{
  display:flex;
  align-items:center;
  justify-content:space-between;

  padding:1.15rem 1.3rem;

  border-bottom:1px solid rgba(15,23,42,.06);

  background:
    radial-gradient(700px 240px at 0% 0%, color-mix(in srgb, var(--theme-color-principal) 7%, transparent), transparent 60%);
}

.cardx-title{
  display:flex;
  align-items:center;
  gap:.75rem;

  margin:0;

  font-size:1.05rem;
  font-weight:950;

  color:var(--ink);
}

.cardx-title i{
  width:42px;
  height:42px;

  display:grid;
  place-items:center;

  border-radius:14px;

  background:
    color-mix(in srgb, var(--theme-color-secondaire) 18%, #fff);

  color:
    color-mix(in srgb, var(--theme-color-principal) 75%, #000 25%);

  border:1px solid rgba(15,23,42,.06);
}

.planner-wrap{
  overflow:auto;
  max-height:75vh;

  border-radius:20px;

  border:1px solid rgba(15,23,42,.06);

  background:#fff;
}

table.planner{
  border-collapse:separate;
  border-spacing:0;

  min-width:
    calc(var(--col-resource) + var(--col-meta) + (var(--cell-w) * 7));

  width:max-content;
}

.planner th,
.planner td{
  border-right:1px solid rgba(15,23,42,.05);
  border-bottom:1px solid rgba(15,23,42,.05);
}

.planner thead th{
  position:sticky;
  top:0;
  z-index:5;

  background:rgba(255,255,255,.96);

  backdrop-filter:blur(10px);
}

.planner .sticky-left-1{
  position:sticky;
  left:0;
  z-index:7;

  background:#fff;

  width:var(--col-resource);
  min-width:var(--col-resource);
  max-width:var(--col-resource);
}

.planner .sticky-left-2{
  position:sticky;
  left:var(--col-resource);
  z-index:7;

  background:#fff;

  width:var(--col-meta);
  min-width:var(--col-meta);
  max-width:var(--col-meta);
}

.planner .month-head{
  padding:.85rem .4rem;

  text-align:center;

  font-size:.95rem;
  font-weight:950;

  color:var(--ink);
}

.planner .day-head{
  width:var(--cell-w);

  text-align:center;

  padding:.55rem .2rem;

  font-size:.78rem;
  font-weight:950;

  color:var(--muted);
}

.planner .resource-cell,
.planner .meta-cell{
  padding:.85rem 1rem;

  background:#fff;

  color:var(--ink);

  font-size:.9rem;
}

.planner .meta-cell{
  color:var(--muted);
  font-weight:850;
}

.planner .row-user .sticky-left-1,
.planner .row-user .sticky-left-2{
  background:
    color-mix(in srgb, var(--theme-color-principal) 4%, #fff);
}

.planner .row-user .resource-cell{
  font-weight:950;
}

.planner .row-engin .resource-cell{
  padding-left:2.5rem;
}

.planner .day-cell{
  width:var(--cell-w);
  min-width:var(--cell-w);
  max-width:var(--cell-w);

  height:58px;

  background:
    linear-gradient(180deg,#fff,#f8fafc);
}

.planner .cell-inner{
  width:100%;
  height:100%;

  display:flex;
  align-items:center;
  justify-content:center;

  padding:5px;
}

.planner-pill{
  width:100%;

  border:0;
  border-radius:15px;

  padding:6px 8px;

  color:#fff;

  font-size:.72rem;
  font-weight:950;
  line-height:1.1;

  box-shadow:0 10px 20px rgba(15,23,42,.12);

  transition:.16s ease;

  cursor:pointer;
}

.planner-pill:hover{
  transform:translateY(-1px) scale(1.02);
}

.planner-pill small{
  display:block;

  margin-top:2px;

  font-size:.66rem;
  font-weight:800;

  opacity:.92;
}

.planner-pill.alx{
  background:linear-gradient(135deg,#16a34a,#166534);
}

.planner-pill.total{
  background:linear-gradient(135deg,#ef4444,#991b1b);
}

.planner-pill.edenred{
  background:linear-gradient(135deg,#eab308,#a16207);
}

.planner-pill.note{
  background:linear-gradient(135deg,#3b82f6,#1d4ed8);
}

/* MODAL */

.modal-premium .modal-content{
  border:1px solid rgba(255,255,255,.72);

  border-radius:32px;

  overflow:hidden;

  background:rgba(255,255,255,.84);

  backdrop-filter:blur(18px);

  box-shadow:var(--shadow-xl);
}

.modal-premium .modal-header{
  border-bottom:0;

  color:#fff;

  background:
    linear-gradient(135deg,
      color-mix(in srgb, var(--theme-color-principal) 92%, #000 8%),
      color-mix(in srgb, var(--theme-color-principal) 58%, var(--theme-color-secondaire) 42%)
    );
}

.detail-card{
  border-radius:20px;

  padding:1rem 1.1rem;

  background:#fff;

  border:1px solid rgba(15,23,42,.06);

  box-shadow:var(--shadow-sm);
}

.detail-label{
  color:var(--ink);
  font-weight:950;
}

.detail-meta{
  color:var(--muted);
  font-size:.8rem;
  font-weight:850;
}

.badge-provider{
  border-radius:999px;

  padding:.35rem .6rem;

  color:#fff;

  font-size:.72rem;
  font-weight:950;
}

.badge-provider.alx{
  background:#16a34a;
}

.badge-provider.total{
  background:#dc2626;
}

.badge-provider.edenred{
  background:#ca8a04;
}

.badge-provider.note{
  background:#2563eb;
}

/* MOBILE */

@media (max-width:1200px){

  .toolbar-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .f-item-lg{
    grid-column:span 2;
  }
}

@media (max-width:900px){

  .kpis{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}

@media (max-width:768px){

  :root{
    --col-resource:220px;
    --col-meta:170px;
    --cell-w:84px;
  }

  .hero{
    padding:1.4rem !important;
  }

  .hero h2{
    font-size:1.45rem;
  }

  .toolbar{
    position:relative;
    top:auto;
  }

  .toolbar-grid{
    grid-template-columns:1fr;
  }

  .f-item-lg{
    grid-column:auto;
  }

  .toolbar-actions{
    flex-wrap:wrap;
  }

  .btn-premium,
  .btn-outline-soft{
    flex:1;
  }

  .kpis{
    grid-template-columns:1fr;
  }
}
  </style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
  <div class="hero p-3 p-md-4 mb-4 d-flex gap-3 align-items-start">
    <div class="accent"></div>
    <div class="flex-grow-1 position-relative" style="z-index:1;">
      <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
        <div>
          <h2 class="m-0 fw-bold">
            <i class="bi bi-calendar3 me-2" style="color:var(--theme-color-secondaire)"></i>
            Planning ressources premium
          </h2>
          <div class="opacity-75 mt-2">
            Vue condensée par <strong>employé</strong> et par <strong>engin utilisé</strong>, avec détail complet au clic.
          </div>

          <div class="d-flex flex-wrap gap-2 mt-3">
            <span class="hero-chip"><i class="bi bi-building"></i> {{ entite.nom }}</span>
            <span class="hero-chip"><i class="bi bi-people"></i> Employés</span>
            <span class="hero-chip"><i class="bi bi-truck-front"></i> Engins</span>
            <span class="hero-chip"><i class="bi bi-cash-stack"></i> Dépenses</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="toolbar mb-4">
    <div class="toolbar-grid">
      <div class="f-item">
        <label class="form-label">Plage de dates</label>
        <input type="text" id="fRange" class="form-control" placeholder="Choisir une période">
      </div>

      <div class="f-item">
        <label class="form-label">Fournisseurs</label>
        <select id="fProviders" multiple>
          <option value="ALX">ALX</option>
          <option value="TOTAL">TOTAL</option>
          <option value="EDENRED">EDENRED</option>
          <option value="NOTE">NOTE</option>
        </select>
      </div>

      <div class="f-item">
        <label class="form-label">Employés</label>
        <select id="fEmployes" multiple>
          {% for u in employes %}
            <option value="{{ u.id }}">{{ u.prenom }} {{ u.nom }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="f-item">
        <label class="form-label">Engins</label>
        <select id="fEngins" multiple>
          {% for e in engins %}
            <option value="{{ e.id }}">{{ e.nom }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="f-item-lg">
        <label class="form-label">Actions</label>
        <div class="toolbar-actions">
          <button type="button" class="btn btn-premium" id="btnApply">
            <i class="bi bi-arrow-repeat me-1"></i>Actualiser
          </button>
          <button type="button" class="btn btn-outline-soft" id="btnToday">
            <i class="bi bi-calendar-day me-1"></i>Aujourd’hui
          </button>
          <button type="button" class="btn btn-outline-soft" id="btnReset">
            <i class="bi bi-x-circle me-1"></i>Reset
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="kpis mb-4">
    <div class="kpi">
      <div class="label">Période</div>
      <div class="value" id="kpiRange">-</div>
    </div>
    <div class="kpi">
      <div class="label">Ressources</div>
      <div class="value" id="kpiResources">-</div>
    </div>
    <div class="kpi">
      <div class="label">Événements</div>
      <div class="value" id="kpiEvents">-</div>
    </div>
    <div class="kpi">
      <div class="label">Montant total</div>
      <div class="value" id="kpiAmount">-</div>
    </div>
  </div>

  <div class="cardx">
    <div class="cardx-h">
      <h5 class="cardx-title">
        <i class="bi bi-diagram-3-fill"></i>
        Planning utilisateur / engins
      </h5>
    </div>

    <div class="p-3">
      <div class="planner-wrap">
        <table class="planner" id="plannerTable">
          <thead id="plannerHead"></thead>
          <tbody id="plannerBody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="modal fade modal-premium" id="eventDetailModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="eventModalTitle">Détail de la journée</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>

      <div class="modal-body p-4">
        <div class="row g-3 mb-3">
          <div class="col-md-3">
            <div class="detail-card">
              <div class="detail-meta">Employé</div>
              <div class="detail-label" id="modalEmploye">-</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="detail-card">
              <div class="detail-meta">Engin</div>
              <div class="detail-label" id="modalEngin">-</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="detail-card">
              <div class="detail-meta">Jour</div>
              <div class="detail-label" id="modalDate">-</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="detail-card">
              <div class="detail-meta">Total</div>
              <div class="detail-label" id="modalTotal">-</div>
            </div>
          </div>
        </div>

        <div id="modalItems" class="d-grid gap-3"></div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://npmcdn.com/flatpickr/dist/l10n/fr.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  if (window.flatpickr && window.flatpickr.l10ns?.fr) {
    flatpickr.localize(flatpickr.l10ns.fr);
  }

  const modalEl = document.getElementById('eventDetailModal');
  const detailModal = (modalEl && window.bootstrap) ? new bootstrap.Modal(modalEl) : null;

  const $range = document.getElementById('fRange');
  const $providers = document.getElementById('fProviders');
  const $employes = document.getElementById('fEmployes');
  const $engins = document.getElementById('fEngins');

  const $head = document.getElementById('plannerHead');
  const $body = document.getElementById('plannerBody');

  const today = new Date();
  const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
  const lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

  function toIso(d) {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function moneyFromCents(cents) {
    return new Intl.NumberFormat('fr-FR', {
      style: 'currency',
      currency: 'EUR'
    }).format((Number(cents || 0) / 100));
  }

  let fp = flatpickr($range, {
    mode: "range",
    dateFormat: "d/m/Y",
    altInput: true,
    altFormat: "j F Y",
    allowInput: true,
    disableMobile: true,
    defaultDate: [firstDay, lastDay]
  });

  new TomSelect($providers, {
    plugins: ['remove_button'],
    hideSelected: true,
    closeAfterSelect: false,
    create: false,
    maxOptions: null,
    placeholder: 'Tous les fournisseurs'
  });

  new TomSelect($employes, {
    plugins: ['remove_button'],
    hideSelected: true,
    closeAfterSelect: false,
    create: false,
    maxOptions: null,
    placeholder: 'Tous les employés'
  });

  new TomSelect($engins, {
    plugins: ['remove_button'],
    hideSelected: true,
    closeAfterSelect: false,
    create: false,
    maxOptions: null,
    placeholder: 'Tous les engins'
  });

  function selectedValues(selectEl) {
    if (!selectEl || !selectEl.tomselect) return [];
    const val = selectEl.tomselect.getValue();
    return Array.isArray(val) ? val : (val ? [val] : []);
  }

  function buildQuery() {
    const params = new URLSearchParams();
    const selected = fp.selectedDates || [];
    const start = selected[0] ? toIso(selected[0]) : '';
    const end = selected[1] ? toIso(selected[1]) : (selected[0] ? toIso(selected[0]) : '');

    if (start) params.set('dateStart', start);
    if (end) params.set('dateEnd', end);

    selectedValues($providers).forEach(v => params.append('providers[]', v));
    selectedValues($employes).forEach(v => params.append('employeIds[]', v));
    selectedValues($engins).forEach(v => params.append('enginIds[]', v));

    return params.toString();
  }

  function providerClass(provider) {
    const p = String(provider || '').toLowerCase();
    if (p === 'alx') return 'alx';
    if (p === 'total') return 'total';
    if (p === 'edenred') return 'edenred';
    return 'note';
  }

  function buildMonthGroups(days) {
    const groups = [];
    for (const d of days) {
      const key = d.monthLabel;
      const last = groups[groups.length - 1];
      if (!last || last.label !== key) {
        groups.push({ label: key, count: 1 });
      } else {
        last.count++;
      }
    }
    return groups;
  }

  function renderHead(days) {
    const monthGroups = buildMonthGroups(days);

    let row1 = `
      <tr>
        <th class="sticky-left-1 resource-head" rowspan="2">Ressource</th>
        <th class="sticky-left-2 meta-head" rowspan="2">Synthèse</th>
    `;

    for (const group of monthGroups) {
      row1 += `<th class="month-head" colspan="${group.count}">${group.label}</th>`;
    }
    row1 += `</tr>`;

    let row2 = `<tr>`;
    for (const day of days) {
      row2 += `<th class="day-head">${day.day}</th>`;
    }
    row2 += `</tr>`;

    $head.innerHTML = row1 + row2;
  }

  function renderCell(cell, userName, enginName, dayDate) {
    if (!cell) {
      return `<td class="day-cell"><div class="cell-inner"></div></td>`;
    }

    return `
      <td class="day-cell">
        <div class="cell-inner">
          <button
            type="button"
            class="planner-pill ${providerClass(cell.provider)}"
            data-cell='${JSON.stringify({
              userName,
              enginName,
              dayDate,
              amount_label: cell.amount_label,
              qty_label: cell.qty_label,
              count: cell.count,
              items: cell.items
            }).replace(/'/g, "&apos;")}'>
            ${cell.amount_label}
            <small>${cell.qty_label}</small>
          </button>
        </div>
      </td>
    `;
  }

  function renderBody(data) {
    const rows = [];
    const cells = data.cells || {};
    const days = data.days || [];

    for (const user of (data.resources || [])) {
      const hasChildren = (user.children || []).length > 0;

      rows.push(`
        <tr class="row-user" data-user="${user.id}">
          <td class="sticky-left-1 resource-cell">
            <button type="button" class="toggle-btn" data-toggle="${user.id}">
              ${hasChildren ? '−' : ''}
            </button>
            ${user.name}
          </td>
          <td class="sticky-left-2 meta-cell">${user.meta}</td>
          ${days.map(() => `<td class="day-cell"></td>`).join('')}
        </tr>
      `);

      for (const child of (user.children || [])) {
        rows.push(`
          <tr class="row-engin" data-parent="${user.id}">
            <td class="sticky-left-1 resource-cell">↳ ${child.name}</td>
            <td class="sticky-left-2 meta-cell">${child.meta}</td>
            ${days.map(day => renderCell(
              (cells[child.id] || {})[day.date] || null,
              user.name,
              child.name,
              day.date
            )).join('')}
          </tr>
        `);
      }
    }

    $body.innerHTML = rows.join('');
  }

  function refreshKpis(data) {
    const selected = fp.selectedDates || [];
    const start = selected[0] ? selected[0].toLocaleDateString('fr-FR') : '-';
    const end = selected[1] ? selected[1].toLocaleDateString('fr-FR') : start;

    document.getElementById('kpiRange').textContent = `${start} → ${end}`;
    document.getElementById('kpiResources').textContent = data.summary?.resource_count || 0;
    document.getElementById('kpiEvents').textContent = data.summary?.event_count || 0;
    document.getElementById('kpiAmount').textContent = data.summary?.amount_label || '-';
  }

  function openDetail(payload) {
    document.getElementById('eventModalTitle').textContent = `Détail du ${payload.dayDate}`;
    document.getElementById('modalEmploye').textContent = payload.userName || '-';
    document.getElementById('modalEngin').textContent = payload.enginName || '-';
    document.getElementById('modalDate').textContent = payload.dayDate || '-';
    document.getElementById('modalTotal').textContent = `${payload.amount_label} • ${payload.qty_label}`;

    const itemsHtml = (payload.items || []).map(item => `
      <div class="detail-card">
        <div class="detail-top">
          <div>
            <div class="detail-label">${item.label || '-'}</div>
            <div class="detail-meta">
              ${item.start_at || '-'} • ${item.user_label || '-'} • ${item.engin_label || '-'}
            </div>
          </div>
          <span class="badge-provider ${providerClass(item.provider)}">${item.provider}</span>
        </div>

        <div class="row g-3 mt-1">
          <div class="col-md-3">
            <div class="detail-meta">Montant</div>
            <div class="detail-label">${moneyFromCents(item.amount_cents)}</div>
          </div>
          <div class="col-md-3">
            <div class="detail-meta">Quantité</div>
            <div class="detail-label">${Number(item.qty || 0).toLocaleString('fr-FR', { minimumFractionDigits: 3, maximumFractionDigits: 3 })} L</div>
          </div>
          <div class="col-md-3">
            <div class="detail-meta">Source</div>
            <div class="detail-label">${item.source_type || '-'}</div>
          </div>
          <div class="col-md-3">
            <div class="detail-meta">Transaction</div>
            <div class="detail-label">${item.tx_id || '-'}</div>
          </div>
        </div>

        ${item.commentaire ? `
          <div class="mt-3">
            <div class="detail-meta">Commentaire</div>
            <div class="detail-label">${item.commentaire}</div>
          </div>
        ` : ''}
      </div>
    `).join('');

    document.getElementById('modalItems').innerHTML = itemsHtml || `
      <div class="detail-card">
        <div class="detail-label">Aucun détail</div>
      </div>
    `;

    if (detailModal) {
      detailModal.show();
    }
  }

  async function refreshPlanning() {
    const response = await fetch(`{{ path('app_administrateur_calendrier_planning_data', {entite: entite.id}) }}?${buildQuery()}`, {
      headers: { 'Accept': 'application/json' }
    });

    if (!response.ok) {
      throw new Error('Erreur lors du chargement du planning');
    }

    const data = await response.json();
    renderHead(data.days || []);
    renderBody(data);
    refreshKpis(data);
  }

  document.getElementById('btnApply')?.addEventListener('click', () => {
    refreshPlanning().catch(console.error);
  });

  document.getElementById('btnToday')?.addEventListener('click', function() {
    const now = new Date();
    const start = new Date(now.getFullYear(), now.getMonth(), 1);
    const end = new Date(now.getFullYear(), now.getMonth() + 1, 0);
    fp.setDate([start, end], true);
    refreshPlanning().catch(console.error);
  });

  document.getElementById('btnReset')?.addEventListener('click', function() {
    fp.setDate([firstDay, lastDay], true);
    if ($providers.tomselect) $providers.tomselect.clear(true);
    if ($employes.tomselect) $employes.tomselect.clear(true);
    if ($engins.tomselect) $engins.tomselect.clear(true);
    refreshPlanning().catch(console.error);
  });

  $body.addEventListener('click', function(e) {
    const toggleBtn = e.target.closest('[data-toggle]');
    if (toggleBtn) {
      const userId = toggleBtn.getAttribute('data-toggle');
      const children = document.querySelectorAll(`tr[data-parent="${userId}"]`);
      const collapsed = toggleBtn.textContent.trim() === '+';

      children.forEach(tr => {
        tr.style.display = collapsed ? '' : 'none';
      });

      toggleBtn.textContent = collapsed ? '−' : '+';
      return;
    }

    const pill = e.target.closest('.planner-pill');
    if (pill) {
      const payload = JSON.parse(pill.getAttribute('data-cell').replace(/&apos;/g, "'"));
      openDetail(payload);
    }
  });

  refreshPlanning().catch(console.error);
});
</script>
{% endblock %}