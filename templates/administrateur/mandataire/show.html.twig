{# templates/administrateur/mandataire/show.html.twig #}
{% extends 'base_admin.html.twig' %}

{% block title %}Mandataire #{{ mandataire.id }}{% endblock %}

{% block body %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">{{ mandataire }}</h2>
      <div class="text-muted">Mandataire #{{ mandataire.id }}</div>
    </div>

    <div class="d-flex gap-2">
      <a href="{{ path('app_administrateur_mandataire_index', {entite: entite.id}) }}" class="btn btn-secondary">
        Retour
      </a>
      <a href="{{ path('app_administrateur_mandataire_modifier', {entite: entite.id, id: mandataire.id}) }}" class="btn btn-warning">
        Modifier
      </a>
    </div>
  </div>

  <div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4">
      <div class="row g-3">
        <div class="col-md-6"><strong>Société :</strong> {{ mandataire.societe ?: '-' }}</div>
        <div class="col-md-6"><strong>Nom :</strong> {{ mandataire.nom ?: '-' }}</div>
        <div class="col-md-6"><strong>Email :</strong> {{ mandataire.email ?: '-' }}</div>
        <div class="col-md-6"><strong>Téléphone :</strong> {{ mandataire.telephone ?: '-' }}</div>
        <div class="col-md-12"><strong>Adresse :</strong> {{ mandataire.adresse ?: '-' }}</div>
        <div class="col-md-4"><strong>Code postal :</strong> {{ mandataire.codePostal ?: '-' }}</div>
        <div class="col-md-8"><strong>Ville :</strong> {{ mandataire.ville ?: '-' }}</div>
        <div class="col-12"><strong>Commentaire :</strong><br>{{ mandataire.commentaire ?: '-' }}</div>
      </div>
    </div>
  </div>
</div>
{% endblock %}