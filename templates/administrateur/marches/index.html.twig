{% extends 'base_admin.html.twig' %}
{% block title %}Marchés suivis · {{ entite.nom }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}"><style>:root{--theme-color-principal:{{ entite.couleurPrincipal|default('#0c503e') }};--theme-color-secondaire:{{ entite.couleurSecondaire|default('#d2c08a') }};--theme-color-tertiaire:#f4f6f9;--theme-color-quaternaire:#183f33}body{background:#f4f6f9}</style><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css"><link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css"><link rel="stylesheet" href="{{ asset('css/insight.css') ~ '?v=20261021-3' }}">{% endblock %}
{% block javascripts %}{{ parent() }}<script defer src="https://code.jquery.com/jquery-3.7.1.min.js"></script><script defer src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script><script defer src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script><script defer src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/fr.js"></script><script defer src="{{ asset('js/insight.js') ~ '?v=20261021-3' }}"></script>{% endblock %}
{% block body %}
<div class="market-tracker">
<header class="market-hero"><div><p class="market-eyebrow">PHILIP FRÈRES · DÉVELOPPEMENT</p><h1>Les bonnes opportunités.<br><em>Au bon moment.</em></h1><p>Vos marchés sélectionnés dans DoubleTrade, réunis dans votre espace.</p></div><div class="market-hero-icon" aria-hidden="true"><i class="bi bi-buildings"></i></div></header>
{% for type, messages in app.flashes %}{% for message in messages %}<div role="status" class="alert alert-{{ type == 'success' ? 'success' : 'warning' }}">{{ message }}</div>{% endfor %}{% endfor %}
<div class="market-heading"><div><h2>Marchés suivis</h2><p>{{ config.authorized ? 'Compte connecté : ' ~ config.account.email : 'Connectez DoubleTrade pour commencer votre veille.' }}</p></div><div class="market-actions"><button class="market-button secondary" data-bs-toggle="modal" data-bs-target="#insight-settings"><i class="bi bi-sliders"></i> Paramètres</button><button class="market-button secondary" data-bs-toggle="modal" data-bs-target="#insight-connect"><i class="bi bi-link-45deg"></i> {{ config.account ? 'Connexion' : 'Connecter DoubleTrade' }}</button><form method="post" action="{{ path('app_administrateur_marches_action', {entite: entite.id, action: 'import'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('insight-' ~ entite.id) }}"><button class="market-button" {{ not config.authorized or not config.account or not config.statuses or config.queued ? 'disabled' }}>Importer la sélection</button></form></div></div>
<div class="market-stats"><article><span>Marchés et lots conservés</span><strong>{{ stats.total }}</strong></article><article><span>Dans la sélection actuelle</span><strong>{{ stats.active|default(0) }}</strong></article><article><span>Sans date limite exploitable</span><strong>{{ stats.undated|default(0) }}</strong></article><article><span>Rappels avant échéance</span><strong>{{ config.alerts ? config.lead_hours ~ ' h' : 'Désactivés' }}</strong></article></div>
<div class="market-notice" role="status"><i class="bi bi-arrow-repeat"></i><div>{{ config.message }}<small>Dernier import complet : {{ config.last_success ? date(config.last_success, 'UTC')|date('d/m/Y à H:i', 'Europe/Paris') : 'aucun' }} · Synchronisation horaire {{ config.auto_sync ? 'activée' : 'désactivée' }}.</small></div></div>
{% if config.alerts and (not config.sync_ok|default(false) or not config.last_success or date(config.last_success, 'UTC') < date('-24 hours')) %}<div class="alert alert-warning">Les rappels sont suspendus jusqu’à un import complet réussi datant de moins de 24 heures.</div>{% endif %}
<section class="market-panel"><div class="market-panel-heading"><h3>Votre portefeuille d’opportunités</h3><span>Recherche · Tri · Fiche complète</span></div><div class="market-table-wrap"><table id="insight-markets" data-url="{{ path('app_administrateur_marches_data', {entite: entite.id}) }}" class="display" style="width:100%"><thead><tr><th>Marché / lot</th><th>Acheteur</th><th>Date limite des offres</th><th>Montant estimé</th><th>Lieux</th><th>Statuts DoubleTrade</th><th>Suivi</th><th>Importé le</th><th>Fiche</th></tr></thead><tbody></tbody></table><p id="insight-table-error" class="text-danger" role="alert" hidden>Le tableau n’a pas pu être chargé. Rechargez la page après avoir vérifié votre connexion.</p></div></section>
<section class="market-panel"><div class="market-panel-heading"><h3>Historique des rappels</h3><span>50 derniers envois</span></div><div class="market-table-wrap">{% if deliveries %}<table class="table"><thead><tr><th>Marché</th><th>Destinataire</th><th>État</th><th>Date</th></tr></thead><tbody>{% for delivery in deliveries %}<tr><td>{{ delivery.title }}</td><td>{{ users[delivery.user_id].name|default('Utilisateur #' ~ delivery.user_id) }}</td><td>{{ delivery.status == 'sent' ? 'Envoyé au serveur SMTP' : 'À vérifier auprès du serveur mail' }}</td><td>{{ date(delivery.updated_at, 'UTC')|date('d/m/Y H:i', 'Europe/Paris') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p>Aucun rappel envoyé. Les destinataires et le délai se définissent dans les paramètres.</p>{% endif %}<small>Un état « à vérifier » ne déclenche pas de nouvel envoi automatique, afin d’éviter les doublons.</small></div></section>
<section class="market-panel market-mail-test"><div class="market-panel-heading"><div><h2><i class="bi bi-envelope-paper" aria-hidden="true"></i> Découvrez vos e-mails</h2><p>Recevez un exemplaire sur votre propre adresse : {{ app.user.email }}.</p></div><span>ENVOI DE TEST</span></div><div class="market-test-body"><div><strong>Le rendu final, dans votre boîte mail.</strong><p>Les tests utilisent les modèles réels et jusqu’à 20 marchés à venir, ou un exemple si la liste est vide. Ils ne modifient pas les rappels programmés.</p></div><div class="market-actions">{% for kind, label in {digest: 'Tester le récapitulatif', deadline: 'Tester le rappel'} %}<form method="post" action="{{ path('app_administrateur_marches_mail_test', {entite: entite.id, kind: kind}) }}"><input type="hidden" name="_token" value="{{ csrf_token('insight-' ~ entite.id) }}"><button class="market-button {{ kind == 'deadline' ? 'secondary' }}"><i class="bi bi-send" aria-hidden="true"></i>{{ label }}</button></form>{% endfor %}</div></div></section>
<section class="market-panel"><div class="market-panel-heading"><h2>Historique des récapitulatifs</h2><span>50 derniers envois</span></div><div class="market-table-wrap"><table class="table"><thead><tr><th>Date prévue</th><th>Destinataire</th><th>État</th><th>Dernière mise à jour</th></tr></thead><tbody>{% for delivery in digests %}<tr><td>{{ delivery.scheduled_date|date('d/m/Y') }}</td><td>{{ users[delivery.user_id].name ?? ('Utilisateur #' ~ delivery.user_id) }}</td><td>{{ delivery.status == 'sent' ? 'Envoyé au serveur SMTP' : 'À vérifier' }}</td><td>{{ delivery.updated_at|date('d/m/Y H:i', 'Europe/Paris') }}</td></tr>{% else %}<tr><td colspan="4">Aucun récapitulatif envoyé pour le moment.</td></tr>{% endfor %}</tbody></table></div></section>
<div class="modal fade" id="insight-settings" tabindex="-1" aria-labelledby="insight-settings-title" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-4" id="insight-settings-title">Paramètres des marchés</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button></div><form method="post" action="{{ path('app_administrateur_marches_settings', {entite: entite.id}) }}"><div class="modal-body"><input type="hidden" name="_token" value="{{ csrf_token('insight-' ~ entite.id) }}">
<h3>01 · Sélection DoubleTrade</h3><p>Seuls les marchés suivis créés par le compte connecté ou qui lui sont assignés, avec les statuts ci-dessous, sont importés. Affectez donc vos sélections à ce compte dans DoubleTrade.</p><div class="market-choices">{% for status in config.status_catalog %}<label><input type="checkbox" name="statuses[]" value="{{ status.id }}" {{ status.id in config.statuses ? 'checked' }}> {{ status.name }}</label>{% else %}<p>Connectez votre compte pour obtenir les statuts disponibles.</p>{% endfor %}</div>
<h3>02 · Informations et consommation API</h3><p>Chaque réponse est stockée intégralement. Les appels de détail et de lots sont distincts. Le tarif exact doit être confirmé auprès d’Intescia ; le plafond ci-dessous compte les requêtes, pas les crédits.</p><label class="market-check"><input type="checkbox" name="include_details" {{ config.include_details ? 'checked' }}> Récupérer la fiche complète de chaque nouveau marché</label><label class="market-check"><input type="checkbox" name="include_lots" {{ config.include_lots ? 'checked' }}> Récupérer tous les lots (pagination comprise)</label><label class="market-check"><input type="checkbox" name="auto_sync" {{ config.auto_sync ? 'checked' }}> Synchroniser la sélection toutes les heures via la tâche planifiée</label><label for="max-calls">Plafond d’appels métier par import</label><input class="form-control" id="max-calls" name="max_calls" type="number" min="5" max="1000" required value="{{ config.max_calls }}"><small>Les fiches et lots déjà enregistrés ne sont pas rappelés à chaque synchronisation. La sélection et ses dates de réponse sont actualisées.</small><label for="custom-fields">Identifiants de champs personnalisés Intescia (facultatif)</label><input class="form-control" id="custom-fields" name="custom_fields" value="{{ config.custom_fields|join(', ') }}" placeholder="Exemple : 12, 25"><small>À obtenir auprès d’Intescia si votre compte utilise des champs personnalisés.</small>
<h3>03 · Alertes d’échéance</h3><label class="market-check"><input type="checkbox" name="alerts" {{ config.alerts ? 'checked' }}> Activer les rappels par e-mail</label><label for="lead-hours">Nombre d’heures avant la date limite</label><input class="form-control" id="lead-hours" name="lead_hours" type="number" min="1" max="8760" required value="{{ config.lead_hours }}"><p>Un rappel par destinataire et par échéance. Un marché importé dans ce délai sera rappelé au prochain passage, s’il n’est pas déjà expiré.</p><h3>04 · Récapitulatif des marchés à venir</h3>
<label class="market-check"><input type="checkbox" name="digest_enabled" {{ config.digest_enabled ? 'checked' }}> Envoyer un récapitulatif périodique</label>
<p>Un e-mail synthétique avec le marché, la date limite et les jours restants, envoyé aux destinataires sélectionnés ci-dessous. Indépendant des rappels d’échéance.</p>
<div class="market-schedule-grid"><div><label for="digest-interval">Fréquence</label><select class="form-control" id="digest-interval" name="digest_interval">{% for value, label in {1: 'Tous les jours', 2: 'Tous les 2 jours', 7: 'Une fois par semaine'} %}<option value="{{ value }}" {{ config.digest_interval == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select>
</div><div><label for="digest-start">Date du premier envoi</label><input class="form-control" id="digest-start" name="digest_start" type="date" required value="{{ config.digest_start ?: 'now'|date('Y-m-d', 'Europe/Paris') }}">
</div><div><label for="digest-time">Heure d’envoi · Europe/Paris</label><input class="form-control" id="digest-time" name="digest_time" type="time" required value="{{ config.digest_time }}"></div></div>
<p>Envoi au premier passage de la tâche planifiée après l’heure choisie (environ 5 minutes de précision). La fréquence part de la date du premier envoi. Aucun e-mail si aucun marché à venir. Un import complet de moins de 24 h est nécessaire : activez la synchronisation horaire pour maintenir les données à jour.</p>
<fieldset><legend class="fs-6">Destinataires actifs de {{ entite.nom }}</legend><label for="insight-recipient-search">Rechercher un destinataire</label><input type="search" class="form-control market-recipient-search" id="insight-recipient-search" placeholder="Rechercher un nom ou une adresse e-mail…" autocomplete="off" aria-controls="insight-recipients"><p id="insight-recipient-empty" role="status" hidden>Aucun destinataire ne correspond à votre recherche.</p><div class="market-choices" id="insight-recipients">{% for user in users %}<label data-recipient><input type="checkbox" name="recipients[]" value="{{ user.id }}" {{ user.id in config.recipients ? 'checked' }}> <span>{{ user.name }}<small>{{ user.email }}</small></span></label>{% else %}<p>Aucun utilisateur actif avec une adresse valide.</p>{% endfor %}</div></fieldset>
</div><div class="modal-footer"><button type="button" class="market-button secondary" data-bs-dismiss="modal">Fermer</button><button class="market-button">Enregistrer</button></div></form></div></div></div>
<div class="modal fade" id="insight-connect" tabindex="-1" aria-labelledby="insight-connect-title" aria-hidden="true"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-4" id="insight-connect-title">Connexion DoubleTrade</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button></div><div class="modal-body">
<p>Créez une application OAuth dans Insight, avec l’option API activée par Intescia. Enregistrez exactement cette adresse de retour :</p><code class="market-callback">{{ callback }}</code>
{% if not ready %}<div class="alert alert-warning">La clé de chiffrement du serveur doit être configurée avant de saisir les identifiants. Consultez le guide d’installation Intescia.</div>{% endif %}
<form method="post" action="{{ path('app_administrateur_marches_connect', {entite: entite.id}) }}" autocomplete="off"><input type="hidden" name="_token" value="{{ csrf_token('insight-' ~ entite.id) }}"><label for="client-id">Client ID</label><input class="form-control" id="client-id" name="client_id" maxlength="250" autocomplete="off"><label for="client-secret">Client Secret</label><input class="form-control" id="client-secret" name="client_secret" type="password" maxlength="4000" autocomplete="new-password"><p>Les identifiants sont chiffrés sur le serveur. Laissez les deux champs vides pour réutiliser ceux déjà enregistrés. Votre mot de passe DoubleTrade sera saisi uniquement chez Intescia.</p><button class="market-button" {{ not ready ? 'disabled' }}>Continuer chez Intescia →</button></form>
{% if config.account %}<hr><div class="market-actions">{% for action, label in {statuses: 'Actualiser les statuts', disconnect: 'Déconnecter et suspendre les alertes'} %}<form method="post" action="{{ path('app_administrateur_marches_action', {entite: entite.id, action: action}) }}"><input type="hidden" name="_token" value="{{ csrf_token('insight-' ~ entite.id) }}"><button class="market-button secondary">{{ label }}</button></form>{% endfor %}</div>{% endif %}
</div></div></div></div>
</div>
{% endblock %}
