{% extends 'base_admin.html.twig' %}
{% block title %}{{ market.title }} · Marchés{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}"><style>:root{--theme-color-principal:{{ entite.couleurPrincipal|default('#0c503e') }};--theme-color-secondaire:{{ entite.couleurSecondaire|default('#d2c08a') }};--theme-color-tertiaire:#f4f6f9;--theme-color-quaternaire:#183f33}body{background:#f4f6f9}</style><link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css"><link rel="stylesheet" href="{{ asset('css/insight.css') }}">{% endblock %}
{% block javascripts %}{{ parent() }}<script defer src="https://code.jquery.com/jquery-3.7.1.min.js"></script><script defer src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script><script defer src="{{ asset('js/insight.js') }}"></script>{% endblock %}
{% block body %}<div class="market-tracker"><div class="market-heading"><a class="market-button secondary" href="{{ path('app_administrateur_marches_index', {entite: entite.id}) }}">← Marchés suivis</a><a class="market-button" href="{{ path('app_administrateur_marches_detail', {entite: entite.id, id: market.id, format: 'json'}) }}">Télécharger toutes les informations</a></div><header class="market-hero"><div><p class="market-eyebrow">FICHE MARCHÉ · {{ market.active ? 'SUIVI ACTIF' : 'CONSERVÉ HORS SÉLECTION' }}</p><h1 class="market-title">{{ market.title }}</h1><p>{{ market.buyer ?: 'Acheteur non renseigné' }}</p></div></header><div class="market-stats"><article><span>Date limite des offres · Paris</span><strong class="market-date">{{ market.deadline ? date(market.deadline, 'UTC')|date('d/m/Y H:i', 'Europe/Paris') : 'Non renseignée' }}</strong></article><article><span>Dernière synchronisation du suivi</span><strong class="market-date">{{ date(market.updated_at, 'UTC')|date('d/m/Y H:i', 'Europe/Paris') }}</strong></article><article><span>Fiche détaillée récupérée le</span><strong class="market-date">{{ payload.enrichment.detail_imported_at|default(null) ? date(payload.enrichment.detail_imported_at, 'UTC')|date('d/m/Y H:i', 'Europe/Paris') : 'Non récupérée' }}</strong></article></div><section class="market-panel"><div class="market-panel-heading"><div><h2>Actualisation complète</h2><p>La sélection actualise la date limite à chaque import. Recharger le détail et les lots effectue des appels API supplémentaires, potentiellement facturés par Intescia.</p></div><form method="post" action="{{ path('app_administrateur_marches_refresh', {entite: entite.id, id: market.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('insight-' ~ entite.id) }}"><button class="market-button secondary" {{ not market.active ? 'disabled' }}>Recharger la fiche et les lots</button></form></div></section><section class="market-panel"><div class="market-panel-heading"><h2>Toutes les informations reçues</h2><span>{{ fields|length }} champs</span></div><div class="market-table-wrap"><p>Les champs ci-dessous proviennent des réponses Intescia. « followed » correspond au suivi actualisé ; « enrichment » conserve la fiche complète et les lots à leur date de récupération. Les fichiers liés ne sont pas téléchargés automatiquement.</p><table id="insight-fields" class="display" style="width:100%"><thead><tr><th>Champ (chemin complet)</th><th>Valeur</th></tr></thead><tbody>{% for field in fields %}<tr><td><code>{{ field[0] }}</code></td><td class="market-field-value">{{ field[1] }}</td></tr>{% endfor %}</tbody></table></div></section></div>{% endblock %}
