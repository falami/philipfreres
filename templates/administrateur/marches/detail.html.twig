{% extends 'base_admin.html.twig' %}
{% block title %}{{ market.title }} · Marchés{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}"><style>:root{--theme-color-principal:{{ entite.couleurPrincipal|default('#0c503e') }};--theme-color-secondaire:{{ entite.couleurSecondaire|default('#d2c08a') }};--theme-color-tertiaire:#f4f6f9;--theme-color-quaternaire:#183f33}body{background:#f4f6f9}</style><link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css"><link rel="stylesheet" href="{{ asset('css/insight.css') ~ '?v=20261021-4' }}"><link rel="stylesheet" href="{{ asset('css/insight-analysis.css') }}">{% endblock %}
{% block javascripts %}{{ parent() }}<script defer src="https://code.jquery.com/jquery-3.7.1.min.js"></script><script defer src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script><script defer src="{{ asset('js/insight.js') ~ '?v=20261023-1' }}"></script>{% endblock %}
{% block body %}<div class="market-tracker"><div class="market-heading"><a class="market-button secondary" href="{{ path('app_administrateur_marches_index', {entite: entite.id}) }}">← Marchés suivis</a><a class="market-button" href="{{ path('app_administrateur_marches_detail', {entite: entite.id, id: market.id, format: 'json'}) }}">Télécharger toutes les informations</a></div><header class="market-hero"><div><p class="market-eyebrow">FICHE MARCHÉ · {{ market.active ? 'SUIVI ACTIF' : 'CONSERVÉ HORS SÉLECTION' }}</p><h1 class="market-title">{{ market.title }}</h1><p>{{ market.buyer ?: 'Acheteur non renseigné' }}</p></div></header><div class="market-stats"><article><span>Date limite des offres · Paris</span><strong class="market-date">{{ market.deadline ? date(market.deadline, 'UTC')|date('d/m/Y H:i', 'Europe/Paris') : 'Non renseignée' }}</strong></article><article><span>Dernière synchronisation du suivi</span><strong class="market-date">{{ date(market.updated_at, 'UTC')|date('d/m/Y H:i', 'Europe/Paris') }}</strong></article><article><span>Fiche détaillée récupérée le</span><strong class="market-date">{{ payload.enrichment.detail_imported_at|default(null) ? date(payload.enrichment.detail_imported_at, 'UTC')|date('d/m/Y H:i', 'Europe/Paris') : 'Non récupérée' }}</strong></article></div><nav class="market-detail-nav" aria-label="Sections de la fiche"><a href="#market-analysis">Analyse et préparation</a><a href="#market-overview">Vue d’ensemble</a><a href="#market-locations">Localisation</a><a href="#market-links">Liens utiles</a><a href="#market-data">Toutes les données</a></nav>
{% include 'administrateur/marches/_analysis.html.twig' %}
<div class="market-detail-grid"><section class="market-panel" id="market-overview"><div class="market-panel-heading"><h2><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Le marché en détail</h2></div><div class="market-detail-body">{% if presentation.reference %}<p class="market-eyebrow">RÉFÉRENCE · {{ presentation.reference }}</p>{% endif %}<dl class="market-facts"><div><dt>Acheteur</dt><dd>{{ market.buyer ?: 'Non renseigné' }}</dd></div><div><dt>Localisation annoncée</dt><dd>{{ presentation.locations|map(location => location.name)|join(' · ') ?: 'Non renseignée' }}</dd></div><div><dt>Suivi</dt><dd><span class="market-status">{{ market.active ? 'Dans votre sélection' : 'Conservé hors sélection' }}</span></dd></div></dl>{% if presentation.description %}<h3>Objet de la consultation</h3><div class="market-description">{{ presentation.description }}</div>{% else %}<p class="market-muted">Le descriptif détaillé n’est pas renseigné dans les données reçues. Consultez les liens et les informations complètes ci-dessous.</p>{% endif %}</div></section>
<section class="market-panel" id="market-links"><div class="market-panel-heading"><h2><i class="bi bi-link-45deg" aria-hidden="true"></i> Liens et documents</h2><span>{{ presentation.links|length }} liens</span></div><div class="market-detail-body">{% for link in presentation.links %}<a class="market-resource-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer"><span><strong>{{ link.host }}</strong><small>{{ link.url }}</small></span><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>{% else %}<p class="market-muted">Aucun lien de consultation disponible dans les données reçues.</p>{% endfor %}<p class="market-muted">Les liens ouvrent les sites d’origine dans un nouvel onglet. Certains documents nécessitent une connexion.</p></div></section></div>
<section class="market-panel" id="market-locations"><div class="market-panel-heading"><div><h2><i class="bi bi-geo-alt" aria-hidden="true"></i> Situer l’intervention</h2><p>Communes d’exécution indiquées dans le marché. La carte est indicative : elle ne localise pas précisément le chantier.</p></div></div><div class="market-location-grid">{% for location in presentation.locations %}<article class="market-location"><div><h3>{{ location.name }}</h3><a href="{{ location.url }}" target="_blank" rel="noopener noreferrer">Ouvrir dans Google Maps ↗</a></div><div class="market-map-placeholder" data-map-src="{{ location.map }}" data-map-title="Carte de {{ location.name }}"><i class="bi bi-map" aria-hidden="true"></i><p>Explorer les alentours de {{ location.name }}</p><button type="button" class="market-button secondary" data-load-market-map>Afficher la carte</button><small>La carte est chargée depuis Google Maps à votre demande.</small></div></article>{% else %}<p class="market-muted">Aucune commune d’exécution renseignée. Consultez les pièces du marché pour connaître le lieu du chantier.</p>{% endfor %}</div></section>
<section class="market-panel"><div class="market-panel-heading"><div><h2>Actualisation complète</h2><p>La sélection actualise la date limite à chaque import. Recharger le détail et les lots effectue des appels API supplémentaires, potentiellement facturés par Intescia.</p></div><form method="post" action="{{ path('app_administrateur_marches_refresh', {entite: entite.id, id: market.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('insight-' ~ entite.id) }}"><button class="market-button secondary" {{ not market.active ? 'disabled' }}>Recharger la fiche et les lots</button></form></div></section><section class="market-panel" id="market-data"><div class="market-panel-heading"><h2>Toutes les informations reçues</h2><span>{{ fields|length }} champs</span></div><div class="market-table-wrap"><p>Les champs ci-dessous proviennent des réponses Intescia. « followed » correspond au suivi actualisé ; « enrichment » conserve la fiche complète et les lots à leur date de récupération. Les fichiers liés ne sont pas téléchargés automatiquement.</p><table id="insight-fields" class="display" style="width:100%"><thead><tr><th>Champ (chemin complet)</th><th>Valeur</th></tr></thead><tbody>{% for field in fields %}<tr><td><code>{{ field[0] }}</code></td><td class="market-field-value">{% if field[2] %}<a href="{{ field[1] }}" target="_blank" rel="noopener noreferrer">{{ field[1] }} ↗</a>{% else %}{{ field[1] }}{% endif %}</td></tr>{% endfor %}</tbody></table></div></section></div>{% endblock %}
