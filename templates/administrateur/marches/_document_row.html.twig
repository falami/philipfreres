<article class="tender-document" data-document-row><div class="tender-form-grid"><label>Pièce ou preuve<input name="documents[{{ index }}][title]" maxlength="200" value="{{ row.title|default('') }}" required placeholder="RC, CCTP, référence chantier…"></label><label>État<select name="documents[{{ index }}][status]">{% for value, label in {missing: 'À récupérer', received: 'Reçu', reviewed: 'Relu'} %}<option value="{{ value }}" {{ row.status|default('missing') == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></label><button type="button" class="tender-remove" data-remove-row aria-label="Retirer cette référence">Retirer</button></div><label>Lien vers la pièce<input type="url" name="documents[{{ index }}][url]" maxlength="2000" value="{{ row.url|default('') }}" placeholder="https://…"></label>{% if row.url|default('') %}<a href="{{ row.url }}" target="_blank" rel="noopener noreferrer">Ouvrir la référence ↗</a>{% endif %}<label>Version, page et points à retenir<input name="documents[{{ index }}][note]" maxlength="2000" value="{{ row.note|default('') }}" placeholder="Version du document · page · exigence ou preuve"></label></article>
