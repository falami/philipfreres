<tr data-cost-row><td><input aria-label="Lot ou phase" name="costs[{{ index }}][group]" value="{{ row.group|default('') }}" maxlength="100" placeholder="Lot 01"></td><td><input aria-label="Poste de chiffrage" name="costs[{{ index }}][label]" value="{{ row.label|default('') }}" maxlength="200" required placeholder="Équipe, transport…"></td><td><input aria-label="Unité" name="costs[{{ index }}][unit]" value="{{ row.unit|default('') }}" maxlength="20" placeholder="h, t…"></td>{% for field in ['quantity', 'cost', 'price'] %}<td><input aria-label="{{ field == 'quantity' ? 'Quantité' : (field == 'cost' ? 'Coût unitaire HT' : 'Prix unitaire HT') }}" type="number" name="costs[{{ index }}][{{ field }}]" value="{{ attribute(row, field)|default(field == 'quantity' ? '1' : '0') }}" min="0" max="{{ field == 'quantity' ? '1000000' : '10000000' }}" step="{{ field == 'quantity' ? '0.001' : '0.01' }}" required data-cost-field="{{ field }}"></td>{% endfor %}<td><button type="button" class="tender-remove" data-remove-row aria-label="Retirer ce poste">×</button></td></tr>
