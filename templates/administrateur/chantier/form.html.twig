        const emailInput = document.getElementById('quickResourceEmail');
        const immatriculationInput = document.getElementById('quickResourceImmatriculation');
        const typeInput = document.getElementById('quickResourceType');
        const numeroSerieInput = document.getElementById('quickResourceNumeroSerie');
        const uniteInput = document.getElementById('quickResourceUnite');
        const errorBox = document.getElementById('quickResourceError');
        const submitBtn = document.getElementById('quickResourceSubmit');

        function hideError() {
          errorBox.classList.add('d-none');
          errorBox.textContent = '';
        }

        function showError(message) {
          errorBox.textContent = message || 'Erreur inconnue.';
          errorBox.classList.remove('d-none');
        }

        function resetFields() {
          hideError();

          [nomInput, prenomInput, emailInput, immatriculationInput, typeInput, numeroSerieInput].forEach(input => {
            if (input) input.value = '';
          });

          if (uniteInput) uniteInput.value = 'kg';

          document.querySelectorAll(
            '.js-field-prenom, .js-field-email, .js-field-immatriculation, .js-field-type, .js-field-numero-serie, .js-field-unite'
          ).forEach(el => el.classList.add('d-none'));
        }

        function openModal(kind) {
          const cfg = config[kind];
          if (!cfg) return;

          resetFields();

          kindInput.value = kind;
          title.textContent = cfg.title;
          nomLabel.textContent = cfg.nomLabel;

          cfg.fields.forEach(field => {
            const fieldEl = document.querySelector(`.js-field-${field}`);
            if (fieldEl) fieldEl.classList.remove('d-none');
          });

          modal.show();

          setTimeout(() => {
            if (kind === 'utilisateur') {
              prenomInput?.focus();
            } else {
              nomInput?.focus();
            }
          }, 250);
        }

        function addOptionToMatchingSelects(kind, id, label) {
          const cfg = config[kind];
          if (!cfg) return;

          const selector = `select[name$="${cfg.selectName}"]`;
          const selects = [...document.querySelectorAll(selector)];

          selects.forEach(select => {
            const value = String(id);

            if (select.tomselect) {
              if (!select.tomselect.options[value]) {
                select.tomselect.addOption({ value, text: label });
              }

              select.tomselect.refreshOptions(false);

              if (!select.value) {
                select.tomselect.setValue(value, true);
              }

              return;
            }

            if (![...select.options].some(opt => opt.value === value)) {
              const option = new Option(label, value, false, !select.value);
              select.add(option);
            }
          });
        }

        document.addEventListener('click', (e) => {
          const btn = e.target.closest('.js-open-quick-resource');
          if (!btn) return;

          openModal(btn.dataset.kind);
        });

        submitBtn?.addEventListener('click', async () => {
          const kind = kindInput.value;
          const nom = (nomInput.value || '').trim();

          if (!nom) {
            showError('Le nom est obligatoire.');
            return;
          }

          if (kind === 'utilisateur' && !(prenomInput.value || '').trim()) {
            showError('Le prénom est obligatoire.');
            return;
          }

          submitBtn.disabled = true;
          hideError();

          const body = new URLSearchParams();
          body.set('_token', '{{ csrf_token('chantier_inline_resource') }}');
          body.set('kind', kind);
          body.set('nom', nom);
          body.set('prenom', prenomInput?.value || '');
          body.set('email', emailInput?.value || '');
          body.set('immatriculation', immatriculationInput?.value || '');
          body.set('type', typeInput?.value || '');
          body.set('numeroSerie', numeroSerieInput?.value || '');
          body.set('unite', uniteInput?.value || 'kg');

          try {
            const response = await fetch('{{ path('app_administrateur_chantier_ajax_ressource_creer', { entite: entite.id }) }}', {
              method: 'POST',
              headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/x-www-form-urlencoded'
              },
              body
            });

            const data = await response.json();

            if (!response.ok || !data.ok) {
              throw new Error(data.message || 'Impossible de créer la ressource.');
            }

            addOptionToMatchingSelects(data.kind, data.id, data.label);

            modal.hide();
            refreshResume();
          } catch (e) {
            showError(e.message || 'Erreur lors de la création.');
          } finally {
            submitBtn.disabled = false;
          }
        });
      }




      function updatePhotoOrders() {
        document.querySelectorAll('[id$="-photos-holder"]').forEach(holder => {
          holder.querySelectorAll('.collection-item').forEach((item, index) => {
            const ordreInput = item.querySelector('.js-photo-ordre');

            if (ordreInput) {
              ordreInput.value = index + 1;
            }
          });
        });
      }

      function initPhotoSortable() {
        document.querySelectorAll('[id$="-photos-holder"]').forEach(holder => {
          if (!holder || !window.Sortable || holder.dataset.sortableInit === '1') {
            return;
          }

          holder.dataset.sortableInit = '1';

          new Sortable(holder, {
            animation: 180,
            handle: '.js-photo-drag-handle',
            draggable: '.collection-item',
            ghostClass: 'sortable-ghost',
            chosenClass: 'sortable-chosen',
            onEnd: () => {
              updatePhotoOrders();
              refreshResume();
            }
          });

          updatePhotoOrders();
        });
      }



      function updateZoneOrders() {
        const holder = document.getElementById('zones-holder');
        if (!holder) return;

        holder.querySelectorAll(':scope > .collection-item').forEach((item, index) => {
          const ordreInput = item.querySelector('.js-zone-ordre');

          if (ordreInput) {
            ordreInput.value = index + 1;
          }
        });
      }

      function initZoneSortable() {
        const holder = document.getElementById('zones-holder');

        if (!holder || !window.Sortable || holder.dataset.zoneSortableInit === '1') {
          return;
        }

        holder.dataset.zoneSortableInit = '1';

        new Sortable(holder, {
          animation: 180,
          handle: '.js-zone-drag-handle',
          draggable: '.zone-item',
          filter: '.empty-placeholder',
          preventOnFilter: false,
          ghostClass: 'zone-sortable-ghost',
          chosenClass: 'zone-sortable-chosen',
          dragClass: 'zone-sortable-drag',
          forceFallback: true,
          fallbackOnBody: true,
          swapThreshold: 0.65,
          onStart: () => {
            document.body.classList.add('is-sorting-zone');
          },
          onEnd: () => {
            document.body.classList.remove('is-sorting-zone');
            updateZoneOrders();
            refreshResume();
          }
        });

        updateZoneOrders();
      }

      function refreshOneZoneTitle(item) {
        if (!item) return;

        const nomInput = item.querySelector('.js-zone-nom-input');
        const parcelleInput = item.querySelector('.js-zone-parcelle-input');

        const title = item.querySelector('.js-zone-title');
        const parcelle = item.querySelector('.js-zone-parcelle');

        const nomValue = (nomInput?.value || '').trim();
        const parcelleValue = (parcelleInput?.value || '').trim();

        if (title) {
          title.textContent = nomValue || 'Sous-chantier';
        }

        if (parcelle) {
          parcelle.textContent = parcelleValue || 'Sans parcelle';
        }
      }

      function initZoneTitles(scope = document) {
        scope.querySelectorAll('.zone-item').forEach(item => {
          refreshOneZoneTitle(item);
        });
      }



      document.addEventListener('input', function (e) {
        if (
          !e.target.classList.contains('js-zone-nom-input') &&
          !e.target.classList.contains('js-zone-parcelle-input')
        ) {
          return;
        }

        const item = e.target.closest('.zone-item');
        refreshOneZoneTitle(item);
      });

      document.addEventListener('change', function (e) {
        if (
          !e.target.classList.contains('js-zone-nom-input') &&
          !e.target.classList.contains('js-zone-parcelle-input')
        ) {
          return;
        }

        const item = e.target.closest('.zone-item');
        refreshOneZoneTitle(item);
      });


      formMain?.addEventListener('submit', () => {
        updateZoneOrders();
        updatePhotoOrders();
      });


      function normalizeSearchText(value) {
        return String(value || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .trim();
      }

      function getZoneSearchData() {
        return [...document.querySelectorAll('#zones-holder > .zone-item')].map((item, index) => {
          const nomInput = item.querySelector('.js-zone-nom-input');
          const parcelleInput = item.querySelector('.js-zone-parcelle-input');

          const nom = (nomInput?.value || '').trim() || 'Sous-chantier';
          const parcelle = (parcelleInput?.value || '').trim() || 'Sans parcelle';

          return {
            item,
            index,
            nom,
            parcelle,
            searchable: normalizeSearchText(`${nom} ${parcelle}`)
          };
        });
      }

      function openAndScrollToZone(zoneItem) {
        if (!zoneItem) return;

        const collapseEl = zoneItem.querySelector('.zone-collapse.collapse');
        const toggleBtn = zoneItem.querySelector('[data-bs-toggle="collapse"]');

        if (collapseEl && window.bootstrap) {
          bootstrap.Collapse.getOrCreateInstance(collapseEl, { toggle: false }).show();
        } else if (toggleBtn && toggleBtn.getAttribute('aria-expanded') !== 'true') {
          toggleBtn.click();
        }

        zoneItem.classList.add('zone-search-highlight');

        setTimeout(() => {
          zoneItem.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }, 180);

        setTimeout(() => {
          zoneItem.classList.remove('zone-search-highlight');
        }, 2200);

        setTimeout(() => {
          zoneItem.querySelectorAll('.js-photo-map').forEach(mapEl => {
            if (mapEl._leafletMap) {
              mapEl._leafletMap.invalidateSize(true);
            }
          });
        }, 450);
      }

      function renderZoneSearchResults(query = '') {
        const resultsEl = document.getElementById('zoneSearchResults');
        const clearBtn = document.getElementById('zoneSearchClear');

        if (!resultsEl) return;

        const normalizedQuery = normalizeSearchText(query);
        resultsEl.innerHTML = '';

        clearBtn?.classList.toggle('d-none', normalizedQuery === '');

        if (normalizedQuery === '') {
          return;
        }

        const zones = getZoneSearchData();
        const matches = zones
          .filter(zone => zone.searchable.includes(normalizedQuery))
          .slice(0, 8);

        if (!matches.length) {
          resultsEl.innerHTML = `
            <div class="zone-search-empty-result">
              <i class="bi bi-info-circle me-1"></i>
              Aucun sous-chantier ou parcelle trouvé.
            </div>
          `;
          return;
        }

        matches.forEach(zone => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'zone-search-result';
          btn.innerHTML = `
            <i class="bi bi-pin-map me-1"></i>
            ${zone.index + 1}. ${zone.nom}
            <span class="text-muted fw-semibold">· ${zone.parcelle}</span>
          `;

          btn.addEventListener('click', () => {
            openAndScrollToZone(zone.item);
          });

          resultsEl.appendChild(btn);
        });
      }

      function initZoneSearch() {
        const input = document.getElementById('zoneSearchInput');
        const clearBtn = document.getElementById('zoneSearchClear');

        if (!input || input.dataset.zoneSearchInit === '1') return;
        input.dataset.zoneSearchInit = '1';

        let timeout = null;

        input.addEventListener('input', () => {
          clearTimeout(timeout);
          timeout = setTimeout(() => {
            renderZoneSearchResults(input.value);
          }, 120);
        });

        input.addEventListener('keydown', e => {
          if (e.key !== 'Enter') return;

          e.preventDefault();

          const first = document.querySelector('#zoneSearchResults .zone-search-result');
          first?.click();
        });

        clearBtn?.addEventListener('click', () => {
          input.value = '';
          renderZoneSearchResults('');
          input.focus();
        });

        document.addEventListener('input', e => {
          if (
            e.target.classList.contains('js-zone-nom-input') ||
            e.target.classList.contains('js-zone-parcelle-input')
          ) {
            renderZoneSearchResults(input.value);
          }
        });

        document.addEventListener('change', e => {
          if (
            e.target.classList.contains('js-zone-nom-input') ||
            e.target.classList.contains('js-zone-parcelle-input')
          ) {
            renderZoneSearchResults(input.value);
          }
        });
      }

      initWidgets(document);
      initRealDatesDefaults();
      initZoneRealDatesDefaults(document);
      initQuickResourceModal();
      initPhotoUploadUI(document);
      bindRemoveButtons(document);
      ensureEmptyPlaceholders();
      initZoneTitles(document);
      initZoneSearch();
      initZoneSortable();
      updateZoneOrders();
      initPhotoSortable();
      updatePhotoOrders();
      initFormValidation({ formName: 'chantier_administrateur' });
      await initPhotoMaps(document);
      refreshResume();
    });
  </script>



<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.js-ts-mandataires').forEach(function (select) {
      if (select.tomselect) {
        select.tomselect.destroy();
      }

      new TomSelect(select, {
        plugins: ['remove_button'],
        maxItems: null,
        persist: false,
        create: false,
        allowEmptyOption: false,
        dropdownParent: 'body',
        placeholder: 'Rechercher un mandataire...',
        searchField: ['text'],
        sortField: {
          field: 'text',
          direction: 'asc'
        },
        render: {
          no_results: function () {
            return `
              <div class="px-3 py-3 text-muted">
                <i class="bi bi-search me-1"></i>
                Aucun mandataire trouvé.
              </div>
            `;
          },
          option: function (data, escape) {
            return `
              <div class="py-2">
                <div class="fw-bold">
                  <i class="bi bi-person-vcard me-1 text-warning"></i>
                  ${escape(data.text)}
                </div>
              </div>
            `;
          },
          item: function (data, escape) {
            return `
              <div>
                <i class="bi bi-person-vcard me-1"></i>
                ${escape(data.text)}
              </div>
            `;
          }
        }
      });
    });
  });



  document.addEventListener('DOMContentLoaded', function(){
    const input = document.querySelector('.js-dynamic-table-data');
    const table = document.getElementById('dynamicTable');
    const thead = table?.querySelector('thead');
    const tbody = table?.querySelector('tbody');

    if(!input || !table || !thead || !tbody) return;

    let data = {
      columns: ['Colonne 1',],
      rows: [
        ['']
      ]
    };

    try {
      if(input.value) {
        const parsed = JSON.parse(input.value);
        if(parsed.columns && parsed.rows) data = parsed;
      }
    } catch(e) {}

    function sync(){
      input.value = JSON.stringify(data);
    }

    function render(){
      thead.innerHTML = '';
      tbody.innerHTML = '';

      const headRow = document.createElement('tr');

      data.columns.forEach((col, index) => {
        const th = document.createElement('th');
        th.innerHTML = `
          <div class="dynamic-col-head">
            <input value="${escapeHtml(col)}" data-col="${index}" class="js-dt-col">

            <button type="button"
                    class="remove-column-btn js-remove-column"
                    data-col="${index}"
                    title="Supprimer cette colonne">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        `;
        headRow.appendChild(th);
      });

      const actionTh = document.createElement('th');
      actionTh.style.width = '48px';
      headRow.appendChild(actionTh);
      thead.appendChild(headRow);

      data.rows.forEach((row, rowIndex) => {
        const tr = document.createElement('tr');

        data.columns.forEach((_, colIndex) => {
          const td = document.createElement('td');
          td.innerHTML = `
            <input value="${escapeHtml(row[colIndex] || '')}" data-row="${rowIndex}" data-col="${colIndex}" class="js-dt-cell">
          `;
          tr.appendChild(td);
        });

        const actionTd = document.createElement('td');
        actionTd.className = 'text-center';
        actionTd.innerHTML = `
          <button type="button" class="remove-cell-btn js-remove-row" data-row="${rowIndex}">
            <i class="bi bi-trash"></i>
          </button>
        `;
        tr.appendChild(actionTd);

        tbody.appendChild(tr);
      });

      sync();
    }

    function escapeHtml(str){
      return String(str ?? '').replace(/[&<>"']/g, s => ({
        '&':'&amp;',
        '<':'&lt;',
        '>':'&gt;',
        '"':'&quot;',
        "'":'&#039;'
      }[s]));
    }

    table.addEventListener('input', function(e){
      if(e.target.classList.contains('js-dt-col')){
        data.columns[e.target.dataset.col] = e.target.value;
      }

      if(e.target.classList.contains('js-dt-cell')){
        data.rows[e.target.dataset.row][e.target.dataset.col] = e.target.value;
      }

      sync();
    });

    document.getElementById('addDynamicRow')?.addEventListener('click', function(){
      data.rows.push(data.columns.map(() => ''));
      render();
    });

    document.getElementById('addDynamicColumn')?.addEventListener('click', function(){
      if(data.columns.length >= 5) {
        alert('Tu peux ajouter jusqu’à 5 colonnes maximum.');
        return;
      }

      data.columns.push('Colonne ' + (data.columns.length + 1));
      data.rows = data.rows.map(row => [...row, '']);
      render();
    });

    table.addEventListener('click', function(e){
      const rowBtn = e.target.closest('.js-remove-row');
      const colBtn = e.target.closest('.js-remove-column');

      if(rowBtn){
        data.rows.splice(parseInt(rowBtn.dataset.row, 10), 1);
        render();
        return;
      }

      if(colBtn){
        const colIndex = parseInt(colBtn.dataset.col, 10);

        if(data.columns.length <= 1){
          alert('Le tableau doit contenir au moins une colonne.');
          return;
        }

        if(!confirm('Supprimer cette colonne ?')){
          return;
        }

        data.columns.splice(colIndex, 1);

        data.rows = data.rows.map(row => {
          const nextRow = [...row];
          nextRow.splice(colIndex, 1);
          return nextRow;
        });

        render();
      }
    });

    render();
  });
</script>



<script>
document.addEventListener('DOMContentLoaded', function () {
  const modalEl = document.getElementById('mandataireQuickModal');
  const form = document.getElementById('quickMandataireForm');
  const submitBtn = document.getElementById('quickMandataireSubmit');
  const errorBox = document.getElementById('quickMandataireError');
  const logoInput = document.getElementById('quickMandataireLogo');
  const logoPreview = document.getElementById('quickMandataireLogoPreview');
  const logoEmpty = document.getElementById('quickMandataireLogoEmpty');

  if (!modalEl || !form || !submitBtn) return;

  logoInput?.addEventListener('change', function () {
    const file = this.files?.[0];

    if (!file || !file.type.startsWith('image/')) return;

    const reader = new FileReader();

    reader.onload = e => {
      logoPreview.src = e.target.result;
      logoPreview.classList.remove('d-none');
      logoEmpty.classList.add('d-none');
    };

    reader.readAsDataURL(file);
  });

  function showMandataireError(message) {
    errorBox.textContent = message || 'Une erreur est survenue.';
    errorBox.classList.remove('d-none');
  }

  function clearMandataireError() {
    errorBox.textContent = '';
    errorBox.classList.add('d-none');
  }

  submitBtn.addEventListener('click', async function () {
    clearMandataireError();

    const nom = form.querySelector('[name="nom"]')?.value.trim();

    if (!nom) {
      showMandataireError('Le nom du mandataire est obligatoire.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Création...';

    try {
      const response = await fetch('{{ path('app_administrateur_chantier_ajax_mandataire_creer', { entite: entite.id }) }}', {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: new FormData(form)
      });

      const data = await response.json();

      if (!response.ok || !data.ok) {
        throw new Error(data.message || 'Impossible de créer le mandataire.');
      }

      const select = document.querySelector('.js-ts-mandataires');

      if (select?.tomselect) {
        select.tomselect.addOption({
          value: String(data.id),
          text: data.label
        });

        select.tomselect.addItem(String(data.id));
        select.tomselect.refreshOptions(false);
      } else if (select) {
        const option = new Option(data.label, data.id, true, true);
        select.add(option);
      }

      form.reset();
      logoPreview.src = '';
      logoPreview.classList.add('d-none');
      logoEmpty.classList.remove('d-none');

      bootstrap.Modal.getOrCreateInstance(modalEl).hide();

    } catch (error) {
      showMandataireError(error.message);
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Créer et sélectionner';
    }
  });
});
</script>
