  <script>
  window.CHANTIER_DEFAULT_LOCATION = {
    address: {{ [
      chantier.adresse ?? '',
      chantier.complement ?? '',
      chantier.codePostal ?? '',
      chantier.ville ?? ''
    ]|filter(v => v is not empty)|join(' ')|json_encode|raw }},
    lat: null,
    lng: null
  };
</script>

  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      if (window.flatpickr && window.flatpickr.l10ns && window.flatpickr.l10ns.fr) {
        flatpickr.localize(flatpickr.l10ns.fr);
      }

      const formMain = document.querySelector('form[name="chantier_administrateur"]');
      const submitButtons = formMain ? [...formMain.querySelectorAll('button[type="submit"]')] : [];

      const codeChantierEl = document.getElementById('{{ form.codeChantier.vars.id }}');
      const nominationChantierEl = document.getElementById('{{ form.nominationChantier.vars.id }}');

      let currentBrowserLocationPromise = null;

      function getBrowserLocation() {
        if (currentBrowserLocationPromise) {
          return currentBrowserLocationPromise;
        }

        currentBrowserLocationPromise = new Promise((resolve) => {
          if (!navigator.geolocation) {
            resolve(null);
            return;
          }

          navigator.geolocation.getCurrentPosition(
            async (position) => {
              const lat = Number(position.coords.latitude).toFixed(7);
              const lng = Number(position.coords.longitude).toFixed(7);

              let address = null;

              try {
                const url = new URL("{{ path('app_administrateur_chantier_reverse_geocode', {entite: entite.id}) }}", window.location.origin);
                url.searchParams.set('lat', lat);
                url.searchParams.set('lng', lng);

                const response = await fetch(url.toString(), {
                  headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const data = await response.json();

                if (response.ok && data.ok) {
                  address = data.display_name || null;
                }
              } catch (_) {}

              resolve({
                lat,
                lng,
                address,
                source: 'browser'
              });
            },
            () => resolve(null),
            {
              enableHighAccuracy: true,
              timeout: 8000,
              maximumAge: 120000
            }
          );
        });

        return currentBrowserLocationPromise;
      }

      async function applyDefaultLocationToPhotoItem(item) {
        if (!item || item.dataset.defaultLocationApplied === '1') {
          return;
        }

        item.dataset.defaultLocationApplied = '1';

        const browserLocation = await getBrowserLocation();

        ['avant', 'apres'].forEach(kind => {
          const latInput = item.querySelector(`.js-photo-lat-${kind}`);
          const lngInput = item.querySelector(`.js-photo-lng-${kind}`);
          const sourceInput = item.querySelector(`.js-photo-source-${kind}`);
          const addressInput = item.querySelector(`.js-photo-address-${kind}`);
          const latVisible = item.querySelector(`.js-photo-lat-visible-${kind}`);
          const lngVisible = item.querySelector(`.js-photo-lng-visible-${kind}`);

          if (!latInput || !lngInput) return;
          if (latInput.value && lngInput.value) return;

          if (browserLocation) {
            latInput.value = browserLocation.lat;
            lngInput.value = browserLocation.lng;

            if (latVisible) latVisible.value = browserLocation.lat;
            if (lngVisible) lngVisible.value = browserLocation.lng;
            if (sourceInput) sourceInput.value = browserLocation.source;
            if (addressInput && browserLocation.address && !addressInput.value) {
              addressInput.value = browserLocation.address;
            }

            return;
          }

          const chantierAddress = (window.CHANTIER_DEFAULT_LOCATION?.address || '').trim();
          if (chantierAddress && addressInput && !addressInput.value) {
            addressInput.value = chantierAddress;
          }
        });
      }

      function getIsoWeek(date) {
        const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
        const dayNum = d.getUTCDay() || 7;

        d.setUTCDate(d.getUTCDate() + 4 - dayNum);

        const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
        const weekNo = Math.ceil((((d - yearStart) / 86400000) + 1) / 7);

        return {
          week: weekNo,
          year: d.getUTCFullYear()
        };
      }

      function updateWeekLabel(input) {
        const targetId = input.dataset.weekTarget;
        if (!targetId) return;

        const target = document.getElementById(targetId);
        if (!target) return;

        let date = null;

        if (input._flatpickr && input._flatpickr.selectedDates.length) {
          date = input._flatpickr.selectedDates[0];
        } else if (input.value) {
          date = new Date(input.value);
        }

        if (!date || Number.isNaN(date.getTime())) {
          target.textContent = 'Semaine : -';
          return;
        }

        const iso = getIsoWeek(date);
        target.textContent = `Semaine : S${String(iso.week).padStart(2, '0')} - ${iso.year}`;
      }

      function initFlatpickr(scope = document) {
        if (!window.flatpickr) return;

        scope.querySelectorAll('.js-datetime').forEach(el => {
          if (el._flatpickr) return;

          const isEndDate =
            el.name?.includes('dateFinPrevisionnelle') ||
            el.name?.includes('dateFinReelle');

          const defaultHour = isEndDate ? 17 : 8;

          flatpickr(el, {
            enableTime: true,
            time_24hr: true,
            minuteIncrement: 15,
            defaultHour: defaultHour,
            defaultMinute: 0,
            dateFormat: 'd/m/Y H:i',
            allowInput: true,
            locale: 'fr',
            appendTo: document.body,
            monthSelectorType: 'dropdown',
            onReady: () => updateWeekLabel(el),
            onChange: () => updateWeekLabel(el),
            onValueUpdate: () => updateWeekLabel(el),
          });

          updateWeekLabel(el);
        });

        scope.querySelectorAll('input[type="date"], .js-datepicker, [data-flatpickr]').forEach(el => {
          if (el._flatpickr || el.classList.contains('js-datetime')) return;

          flatpickr(el, {
            dateFormat: 'Y-m-d',
            altInput: true,
            altFormat: 'd/m/Y',
            allowInput: true,
            locale: 'fr'
          });
        });
      }

      function initTomSelectOn(el, options = {}) {
        if (!el || el.tomselect) return;

        const isMultiple = el.hasAttribute('multiple');

        new TomSelect(el, Object.assign({
          dropdownParent: 'body',
          create: false,
          allowEmptyOption: true,
          plugins: isMultiple ? ['remove_button'] : [],
          sortField: { field: 'text', direction: 'asc' },
          onChange: () => refreshResume()
        }, options));
      }

      function initGenericTomSelect(scope = document) {
        if (!window.TomSelect) return;

        scope.querySelectorAll('select').forEach(select => {
          if (
            select.classList.contains('no-tomselect') ||
            select.classList.contains('js-ts-mandataires') ||
            select.classList.contains('js-ts-affectations') ||
            select.dataset.noTomselect === '1'
          ) {
            return;
          }

          initTomSelectOn(select);
        });
      }

      function initMandatairesTomSelect(scope = document) {
        if (!window.TomSelect) return;

        scope.querySelectorAll('.js-ts-mandataires').forEach(select => {
          if (select.tomselect) return;

          new TomSelect(select, {
            plugins: ['remove_button'],
            maxItems: null,
            persist: false,
            create: false,
            dropdownParent: 'body',
            placeholder: 'Sélectionner un ou plusieurs mandataires',
            searchField: ['text'],
            sortField: { field: 'text', direction: 'asc' },
            onChange: () => refreshResume()
          });
        });
      }

      function normalizeSearch(value) {
        return String(value || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '');
      }

      function initAffectationsTomSelect(scope = document) {
        if (!window.TomSelect) return;

        scope.querySelectorAll('.js-ts-affectations').forEach(select => {
          if (select.tomselect) {
            select.tomselect.destroy();
          }

          const options = Array.from(select.options || [])
            .filter(option => option.value !== '')
            .map(option => ({
              value: option.value,
              text: option.textContent.trim(),
              search: normalizeSearch(option.textContent.trim())
            }));

          new TomSelect(select, {
            options: options,
            items: Array.from(select.selectedOptions || []).map(option => option.value),

            plugins: ['remove_button'],
            maxItems: null,
            persist: false,
            create: false,
            dropdownParent: 'body',

            valueField: 'value',
            labelField: 'text',
            searchField: ['text', 'search'],

            placeholder: 'Rechercher un utilisateur...',

            score: function(search) {
              const normalizedSearch = normalizeSearch(search);

              return function(item) {
                return item.search.includes(normalizedSearch) ? 1 : 0;
              };
            },

            sortField: {
              field: 'text',
              direction: 'asc'
            },

            render: {
              option: function(item, escape) {
                return `
                  <div class="px-3 py-2">
                    <div class="fw-bold">${escape(item.text)}</div>
                  </div>
                `;
              },
              item: function(item, escape) {
                return `<div>${escape(item.text)}</div>`;
              },
              no_results: function() {
                return `
                  <div class="px-3 py-3 text-muted">
                    <i class="bi bi-search me-1"></i>
                    Aucun utilisateur trouvé.
                  </div>
                `;
              }
            },

            onChange: () => refreshResume()
          });
        });
      }

      function initWidgets(scope = document) {
        initFlatpickr(scope);
        initGenericTomSelect(scope);
        initMandatairesTomSelect(scope);
        initAffectationsTomSelect(scope);
      }

      initWidgets(document);

      function initRealDatesDefaults() {
        const debutPrev = document.getElementById('{{ form.dateDebutPrevisionnelle.vars.id }}');
        const finPrev = document.getElementById('{{ form.dateFinPrevisionnelle.vars.id }}');
        const debutReel = document.getElementById('{{ form.dateDebutReelle.vars.id }}');
        const finReel = document.getElementById('{{ form.dateFinReelle.vars.id }}');

        function syncDate(source, target) {
          if (!source || !target) return;

          const copy = () => {
            if (!target.value && source.value) {
              target.value = source.value;

              if (target._flatpickr) {
                target._flatpickr.setDate(source.value, true, 'd/m/Y H:i');
              }

              updateWeekLabel(target);
            }
          };

          copy();
          source.addEventListener('change', copy);
        }

        syncDate(debutPrev, debutReel);
        syncDate(finPrev, finReel);
      }


      function initZoneRealDatesDefaults(scope = document) {
        const zoneItems = [];

        if (scope.classList && scope.classList.contains('zone-item')) {
          zoneItems.push(scope);
        }

        scope.querySelectorAll?.('.zone-item').forEach(item => zoneItems.push(item));

        zoneItems.forEach(zoneItem => {
          if (zoneItem.dataset.realDatesInit === '1') return;
          zoneItem.dataset.realDatesInit = '1';

          const debutPrev = zoneItem.querySelector('input[name$="[dateDebutPrevisionnelle]"]');
          const finPrev = zoneItem.querySelector('input[name$="[dateFinPrevisionnelle]"]');
          const debutReel = zoneItem.querySelector('input[name$="[dateDebutReelle]"]');
          const finReel = zoneItem.querySelector('input[name$="[dateFinReelle]"]');

          function syncDate(source, target) {
            if (!source || !target) return;

            const copy = () => {
              const sourceValue = source.value;

              if (!sourceValue || target.value) {
                return;
              }

              if (target._flatpickr) {
                target._flatpickr.setDate(sourceValue, true, 'd/m/Y H:i');
              } else {
                target.value = sourceValue;
              }
            };

            copy();

            source.addEventListener('change', copy);
            source.addEventListener('input', copy);

            if (source._flatpickr) {
              source._flatpickr.config.onChange.push(copy);
              source._flatpickr.config.onValueUpdate.push(copy);
            }
          }

          syncDate(debutPrev, debutReel);
          syncDate(finPrev, finReel);
        });
      }


      function distanceMeters(lat1, lng1, lat2, lng2) {
        const R = 6371000;
        const toRad = deg => deg * Math.PI / 180;

        const dLat = toRad(lat2 - lat1);
        const dLng = toRad(lng2 - lng1);

        const a =
          Math.sin(dLat / 2) * Math.sin(dLat / 2) +
          Math.cos(toRad(lat1)) *
          Math.cos(toRad(lat2)) *
          Math.sin(dLng / 2) *
          Math.sin(dLng / 2);

        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }
      
      async function initPhotoMaps(scope = document) {
        const items = [];

        if (scope.classList && scope.classList.contains('js-photo-item')) {
          items.push(scope);
        }

        scope.querySelectorAll?.('.js-photo-item').forEach(item => items.push(item));

        for (const item of items) {
          if (item.dataset.mapInit === '1') continue;

          const hasSavedAvant =
            item.querySelector('.js-photo-lat-avant')?.value &&
            item.querySelector('.js-photo-lng-avant')?.value;

          const hasSavedApres =
            item.querySelector('.js-photo-lat-apres')?.value &&
            item.querySelector('.js-photo-lng-apres')?.value;

          const isNewPhoto = item.dataset.newPhoto === '1';

          // ✅ On propose la position navigateur uniquement pour une NOUVELLE photo
          // ✅ Jamais pour une photo déjà chargée depuis la base
          if (isNewPhoto && (!hasSavedAvant || !hasSavedApres)) {
            await applyDefaultLocationToPhotoItem(item);
          }

          item.dataset.mapInit = '1';

          const configs = ['avant', 'apres'];

          for (const kind of configs) {
            const mapEl = item.querySelector(`.js-photo-map[data-kind="${kind}"]`);
            const addressInput = item.querySelector(`.js-photo-address-${kind}`);
            const latInput = item.querySelector(`.js-photo-lat-${kind}`);
            const lngInput = item.querySelector(`.js-photo-lng-${kind}`);
            const sourceInput = item.querySelector(`.js-photo-source-${kind}`);
            const latVisible = item.querySelector(`.js-photo-lat-visible-${kind}`);
            const lngVisible = item.querySelector(`.js-photo-lng-visible-${kind}`);
            const geocodeBtn = item.querySelector(`.js-geocode-photo[data-kind="${kind}"]`);
            const applyCoordsBtn = item.querySelector(`.js-apply-coords[data-kind="${kind}"]`);

            if (!mapEl || !latInput || !lngInput) continue;
            if (mapEl.dataset.mapReady === '1') continue;
            mapEl.dataset.mapReady = '1';

            const defaultLat = parseFloat(latInput.value || '43.604652');
            const defaultLng = parseFloat(lngInput.value || '1.444209');
            const hasCoords = !!(latInput.value && lngInput.value);

            if (latVisible) latVisible.value = latInput.value || '';
            if (lngVisible) lngVisible.value = lngInput.value || '';

            const map = L.map(mapEl).setView([defaultLat, defaultLng], hasCoords ? 17 : 6);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              maxZoom: 20,
              attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            const marker = L.marker([defaultLat, defaultLng], {
              draggable: true
            }).addTo(map);


            let liveMarker = null;
            let targetMarker = null;
            let accuracyCircle = null;
            let watchId = null;

            const livePanel = item.querySelector('.js-live-location-panel');
            const liveDistance = item.querySelector('.js-live-distance');
            const liveAccuracy = item.querySelector('.js-live-accuracy');
            const useCurrentBtn = item.querySelector(`.js-use-current-position[data-kind="${kind}"]`);

            const avantLatInput = item.querySelector('.js-photo-lat-avant');
            const avantLngInput = item.querySelector('.js-photo-lng-avant');

            function updateDistanceDisplay(distance, accuracy = null) {
              if (!liveDistance) return;

              liveDistance.textContent = distance < 1000
                ? `${Math.round(distance)} m`
                : `${(distance / 1000).toFixed(2)} km`;

              liveDistance.classList.remove('live-distance-ok', 'live-distance-warn', 'live-distance-bad');

              if (distance <= 5) {
                liveDistance.classList.add('live-distance-ok');
              } else if (distance <= 20) {
                liveDistance.classList.add('live-distance-warn');
              } else {
                liveDistance.classList.add('live-distance-bad');
              }

              if (liveAccuracy) {
                liveAccuracy.textContent = accuracy
                  ? `Précision GPS : ±${Math.round(accuracy)} m`
                  : 'Précision GPS : -';
              }
            }

            function startLivePositionForAfterMap() {
              if (kind !== 'apres') return;
              if (!navigator.geolocation) return;

              const avantLat = parseFloat(avantLatInput?.value || '');
              const avantLng = parseFloat(avantLngInput?.value || '');

              if (!Number.isFinite(avantLat) || !Number.isFinite(avantLng)) {
                return;
              }

              livePanel?.classList.remove('d-none');

              targetMarker = L.marker([avantLat, avantLng], {
                draggable: false,
                opacity: 0.95
              }).addTo(map);

              targetMarker.bindPopup('Point de référence : photo avant');

              watchId = navigator.geolocation.watchPosition(
                position => {
                  const currentLat = position.coords.latitude;
                  const currentLng = position.coords.longitude;
                  const accuracy = position.coords.accuracy;

                  if (!liveMarker) {
                    liveMarker = L.circleMarker([currentLat, currentLng], {
                      radius: 8,
                      weight: 3,
                      fillOpacity: 0.85
                    }).addTo(map);

                    liveMarker.bindPopup('Votre position actuelle');
                  } else {
                    liveMarker.setLatLng([currentLat, currentLng]);
                  }

                  if (!accuracyCircle) {
                    accuracyCircle = L.circle([currentLat, currentLng], {
                      radius: accuracy || 0,
                      weight: 1,
                      fillOpacity: 0.08
                    }).addTo(map);
                  } else {
                    accuracyCircle.setLatLng([currentLat, currentLng]);
                    accuracyCircle.setRadius(accuracy || 0);
                  }

                  const distance = distanceMeters(currentLat, currentLng, avantLat, avantLng);
                  updateDistanceDisplay(distance, accuracy);
                },
                () => {
                  if (liveAccuracy) {
                    liveAccuracy.textContent = 'Position actuelle indisponible.';
                  }
                },
                {
                  enableHighAccuracy: true,
                  maximumAge: 2000,
                  timeout: 10000
                }
              );
            }

            useCurrentBtn?.addEventListener('click', async () => {
              if (!navigator.geolocation) {
                alert('La géolocalisation n’est pas disponible sur cet appareil.');
                return;
              }

              navigator.geolocation.getCurrentPosition(
                async position => {
                  await setCoords(
                    position.coords.latitude,
                    position.coords.longitude,
                    'gps_apres',
                    true,
                    true
                  );
                },
                () => alert('Impossible de récupérer votre position actuelle.'),
                {
                  enableHighAccuracy: true,
                  timeout: 10000,
                  maximumAge: 0
                }
              );
            });

            startLivePositionForAfterMap();

            if (!hasCoords) {
              marker.setOpacity(0.55);
            }

            async function setCoords(lat, lng, source = 'manuel', center = true, updateAddress = false) {
              latInput.value = Number(lat).toFixed(7);
              lngInput.value = Number(lng).toFixed(7);

              if (latVisible) latVisible.value = latInput.value;
              if (lngVisible) lngVisible.value = lngInput.value;
              if (sourceInput) sourceInput.value = source;

              marker.setLatLng([lat, lng]);
              marker.setOpacity(1);

              if (center) {
                map.setView([lat, lng], Math.max(map.getZoom(), 17));
                setTimeout(() => map.invalidateSize(true), 100);
              }

              if (updateAddress && addressInput) {
                try {
                  const url = new URL("{{ path('app_administrateur_chantier_reverse_geocode', {entite: entite.id}) }}", window.location.origin);
                  url.searchParams.set('lat', lat);
                  url.searchParams.set('lng', lng);

                  const response = await fetch(url.toString(), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                  });

                  const data = await response.json();

                  if (response.ok && data.ok && data.display_name) {
                    addressInput.value = data.display_name;
                  }
                } catch (_) {}
              }
            }

            marker.on('dragend', async () => {
              const pos = marker.getLatLng();
              await setCoords(pos.lat, pos.lng, 'manuel', false, true);
            });

            map.on('click', async (e) => {
              await setCoords(e.latlng.lat, e.latlng.lng, 'manuel', false, true);
            });

            applyCoordsBtn?.addEventListener('click', async () => {
              const lat = parseFloat(latVisible?.value || '');
              const lng = parseFloat(lngVisible?.value || '');

              if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
                alert('Latitude / longitude invalides.');
                return;
              }

              await setCoords(lat, lng, 'manuel', true, true);
            });

            geocodeBtn?.addEventListener('click', async () => {
              const address = (addressInput?.value || '').trim();
              if (!address) {
                alert('Merci de saisir une adresse.');
                return;
              }

              geocodeBtn.disabled = true;

              try {
                const url = new URL("{{ path('app_administrateur_chantier_geocode', {entite: entite.id}) }}", window.location.origin);
                url.searchParams.set('q', address);

                const response = await fetch(url.toString(), {
                  headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const data = await response.json();

                if (!response.ok || !data.ok) {
                  throw new Error(data.message || 'Adresse introuvable');
                }

                const lat = parseFloat(data.latitude);
                const lng = parseFloat(data.longitude);

                if (addressInput && data.display_name) {
                  addressInput.value = data.display_name;
                }

                await setCoords(lat, lng, 'geocodage', true, false);
                setTimeout(() => map.invalidateSize(), 120);
              } catch (e) {
                alert(e.message || 'Erreur lors de la localisation.');
              } finally {
                geocodeBtn.disabled = false;
              }
            });

            function fixMapSize() {
              setTimeout(() => map.invalidateSize(true), 80);
              setTimeout(() => map.invalidateSize(true), 250);
              setTimeout(() => map.invalidateSize(true), 600);
            }

            fixMapSize();

            mapEl._leafletMap = map;
          }
        }
      }


      document.addEventListener('shown.bs.collapse', function (event) {
        event.target.querySelectorAll('.js-photo-map').forEach(mapEl => {
          if (mapEl._leafletMap) {
            setTimeout(() => mapEl._leafletMap.invalidateSize(true), 80);
            setTimeout(() => mapEl._leafletMap.invalidateSize(true), 250);
          }
        });
      });


      function initPhotoUploadUI(scope = document) {
        scope.querySelectorAll('.js-dropzone').forEach(zone => {
          if (zone.dataset.uploadInit === '1') return;
          zone.dataset.uploadInit = '1';

          const inputId = zone.dataset.targetInputId;
          const input = zone.querySelector(`#${CSS.escape(inputId)}`) || document.getElementById(inputId);
          const preview = zone.querySelector('.js-photo-preview');
          const previewImg = zone.querySelector('.js-photo-preview-img');
          const replaceBtn = zone.querySelector('.js-photo-replace');
          const removeBtn = zone.querySelector('.js-photo-remove');
          const inner = zone.querySelector('.photo-dropzone__inner');

          if (!input || !preview || !previewImg || !inner) return;

          function showPreview(file) {
            if (!file || !file.type.startsWith('image/')) return;

            const reader = new FileReader();
            reader.onload = e => {
              previewImg.src = e.target.result;
              preview.classList.remove('d-none');
              inner.classList.add('d-none');
            };
            reader.readAsDataURL(file);
          }

          function clearPreview() {
            input.value = '';
            previewImg.src = '';
            preview.classList.add('d-none');
            inner.classList.remove('d-none');
          }

          zone.addEventListener('click', e => {
            if (e.target.closest('.js-photo-remove') || e.target.closest('.js-photo-replace')) return;
            input.click();
          });

          replaceBtn?.addEventListener('click', e => {
            e.preventDefault();
            e.stopPropagation();
            input.click();
          });

          removeBtn?.addEventListener('click', e => {
            e.preventDefault();
            e.stopPropagation();
            clearPreview();
          });

          input.addEventListener('change', () => {
            const file = input.files?.[0];

            if (file) {
              showPreview(file);

              const item = zone.closest('.js-photo-item') || zone.closest('.collection-item');
              const isAvant = input.name.includes('[avantFile]');
              const isApres = input.name.includes('[apresFile]');

              const dateInput = isAvant
                ? item?.querySelector('.js-photo-date-avant')
                : isApres
                  ? item?.querySelector('.js-photo-date-apres')
                  : null;

              if (dateInput && !dateInput.value) {
                const suggestedDate = new Date(file.lastModified || Date.now());
                const yyyy = suggestedDate.getFullYear();
                const mm = String(suggestedDate.getMonth() + 1).padStart(2, '0');
                const dd = String(suggestedDate.getDate()).padStart(2, '0');
                const value = `${yyyy}-${mm}-${dd}`;

                dateInput.value = value;

                if (dateInput._flatpickr) {
                  dateInput._flatpickr.setDate(value, true);
                }
              }
            } else {
              clearPreview();
            }
          });

          ['dragenter', 'dragover'].forEach(eventName => {
            zone.addEventListener(eventName, e => {
              e.preventDefault();
              e.stopPropagation();
              zone.classList.add('is-dragover');
            });
          });

          ['dragleave', 'dragend', 'drop'].forEach(eventName => {
            zone.addEventListener(eventName, e => {
              e.preventDefault();
              e.stopPropagation();
              zone.classList.remove('is-dragover');
            });
          });

          zone.addEventListener('drop', e => {
            const files = e.dataTransfer?.files;
            if (!files || !files.length) return;

            const file = files[0];
            if (!file.type.startsWith('image/')) return;

            const dt = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            input.dispatchEvent(new Event('change', { bubbles: true }));
          });
        });
      }

      function bindRemoveButtons(scope = document) {
        scope.querySelectorAll('.remove-collection-item').forEach(btn => {
          if (btn.dataset.bound === '1') return;
          btn.dataset.bound = '1';

          btn.addEventListener('click', () => {
            const holder = btn.closest('.collection-holder') || btn.parentElement?.parentElement;
            btn.closest('.collection-item')?.remove();
            ensureEmptyPlaceholders();
            refreshResume();
            updatePhotoOrders();
            updateZoneOrders();
          });
        });
      }

      function ensureEmptyPlaceholders() {
        document.querySelectorAll('.collection-holder').forEach(holder => {
          const items = holder.querySelectorAll('.collection-item');
          let placeholder = holder.querySelector('.empty-placeholder');

          if (!items.length) {
            if (!placeholder) {
              placeholder = document.createElement('div');
              placeholder.className = 'collection-empty empty-placeholder';
              placeholder.innerHTML = '<i class="bi bi-inbox me-1"></i> Aucun élément ajouté pour le moment.';
              holder.appendChild(placeholder);
            }
          } else if (placeholder) {
            placeholder.remove();
          }
        });
      }

      document.addEventListener('click', async (e) => {
        const btn = e.target.closest('.add-collection-item');
        if (!btn) return;

        const holder = document.querySelector(btn.dataset.collectionHolder);
        if (!holder) return;

        const placeholder = holder.querySelector('.empty-placeholder');
        if (placeholder) placeholder.remove();

        const index = parseInt(holder.dataset.index || '0', 10);
        const prototypeName = holder.dataset.prototypeName || '__name__';
        const proto = holder.dataset.prototype.replaceAll(prototypeName, index);

        const item = document.createElement('div');
        const isZoneHolder = holder.id === 'zones-holder';
        item.className = isZoneHolder ? 'collection-item zone-item' : 'collection-item';

        item.innerHTML = `
          <button type="button" class="btn btn-outline-danger btn-sm remove-collection-item">
            <i class="bi bi-trash"></i>
          </button>
          ${proto}
        `;

        if (item.classList.contains('js-photo-item')) {
          item.dataset.newPhoto = '1';
        }

        item.querySelectorAll('.js-photo-item').forEach(photoItem => {
          photoItem.dataset.newPhoto = '1';
        });

        holder.appendChild(item);
        holder.dataset.index = String(index + 1);

        bindRemoveButtons(item);
        initWidgets(item);
        initZoneRealDatesDefaults(item);
        if (isZoneHolder) {
          initZoneTitles(item);
          initZoneSortable();
          updateZoneOrders();
          renderZoneSearchResults(document.getElementById('zoneSearchInput')?.value || '');
        }

        initPhotoUploadUI(item);
        await initPhotoMaps(item);
        initPhotoSortable();
        updatePhotoOrders();
        refreshResume();
      });

