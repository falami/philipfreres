        photos: document.getElementById('resume-photos')
      };

      function selectedText(selectEl) {
        if (!selectEl || !selectEl.value) return '';
        const opt = selectEl.selectedOptions && selectEl.selectedOptions[0];
        return (opt ? opt.textContent : '').trim();
      }

      function countItems(selector) {
        return document.querySelectorAll(selector + ' .collection-item').length;
      }

      function refreshResume() {
        if (resume.nom) resume.nom.textContent = (fields.nom?.value || '').trim() || '-';
        if (resume.statut) resume.statut.textContent = selectedText(fields.statut) || '-';
        if (resume.ville) resume.ville.textContent = (fields.ville?.value || '').trim() || '-';
        if (resume.codeChantier) {
          resume.codeChantier.textContent = fields.codeChantier?.value?.trim() || '-';
        }
        if (resume.nominationChantier) {
          resume.nominationChantier.textContent = fields.nominationChantier?.value?.trim() || '-';
        }
        if (resume.zones) resume.zones.textContent = document.querySelectorAll('#zones-holder > .collection-item').length;
        if (resume.rh) resume.rh.textContent = document.querySelectorAll('[id$="-ressourcesHumaines-holder"] .collection-item').length;
        if (resume.engins) resume.engins.textContent = document.querySelectorAll('[id$="-ressourcesEngins-holder"] .collection-item').length;
        if (resume.materiels) resume.materiels.textContent = document.querySelectorAll('[id$="-ressourcesMateriels-holder"] .collection-item').length;
        if (resume.dechets) resume.dechets.textContent = document.querySelectorAll('[id$="-dechets-holder"] .collection-item').length;
        if (resume.photos) resume.photos.textContent = document.querySelectorAll('[id$="-photos-holder"] .collection-item').length;


        if (resume.codeChantier) {
          resume.codeChantier.textContent = codeChantierEl?.value?.trim() || '-';
        }

        if (resume.nominationChantier) {
          resume.nominationChantier.textContent = nominationChantierEl?.value?.trim() || '-';
        }



        const hasNom = !!((fields.nom?.value || '').trim());
        const hasStatut = !!((fields.statut?.value || '').trim());
        const hasVille = !!((fields.ville?.value || '').trim());

        const ok = hasNom && hasStatut && hasVille && (formMain ? formMain.checkValidity() : true);

        submitButtons.forEach(btn => btn.disabled = !ok);

        if (resume.pill) {
          if (ok) {
            resume.pill.textContent = '✅ Complet';
            resume.pill.style.background = 'rgba(25,135,84,.15)';
            resume.pill.style.borderColor = 'rgba(25,135,84,.35)';
            resume.pill.style.color = 'var(--ink)';
          } else {
            resume.pill.textContent = '⚠️ Incomplet';
            resume.pill.style.background = 'rgba(255,193,7,.15)';
            resume.pill.style.borderColor = 'rgba(255,193,7,.35)';
            resume.pill.style.color = 'var(--ink)';
          }
        }
      }

      function initFormValidation({ formName }) {
        const form = document.querySelector(`form[name="${formName}"]`);
        if (!form) return;

        let errorAlert = document.getElementById('premium-client-form-alert');

        if (!errorAlert) {
          errorAlert = document.createElement('div');
          errorAlert.id = 'premium-client-form-alert';
          errorAlert.className = 'premium-form-alert d-none mb-4';
          errorAlert.innerHTML = `
            <div class="premium-form-alert__icon">
              <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="premium-form-alert__content">
              <div class="premium-form-alert__title">Vérification nécessaire avant enregistrement</div>
              <div class="premium-form-alert__text js-premium-error-text">
                Certains champs sont incomplets ou invalides.
              </div>
              <div class="premium-form-alert__hint">
                <i class="bi bi-arrow-down-circle me-1"></i>
                Le premier champ à corriger est affiché automatiquement.
              </div>
            </div>
          `;

          form.prepend(errorAlert);
        }

        function getFieldLabel(field) {
          const label = field.id ? form.querySelector(`label[for="${field.id}"]`) : null;
          return label ? label.textContent.trim().replace(/\s+/g, ' ') : 'Champ à compléter';
        }

        function openParentZone(field) {
          const zoneItem = field.closest('.zone-item');
          if (!zoneItem) return;

          zoneItem.classList.add('has-validation-error');

          const collapseEl = zoneItem.querySelector('.zone-collapse.collapse');

          if (collapseEl && window.bootstrap) {
            bootstrap.Collapse.getOrCreateInstance(collapseEl, { toggle: false }).show();
          }
        }

        function markInvalid(field) {
          field.classList.add('is-invalid');

          if (field.tomselect) {
            field.tomselect.wrapper.classList.add('is-invalid');
          }

          openParentZone(field);
        }

        function clearInvalidState() {
          form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
          form.querySelectorAll('.ts-wrapper.is-invalid').forEach(el => el.classList.remove('is-invalid'));
          form.querySelectorAll('.zone-item.has-validation-error').forEach(el => el.classList.remove('has-validation-error'));
          errorAlert.classList.add('d-none');
        }

        form.addEventListener('input', e => {
          e.target.classList.remove('is-invalid');

          if (e.target.tomselect) {
            e.target.tomselect.wrapper.classList.remove('is-invalid');
          }
        });

        form.addEventListener('change', e => {
          e.target.classList.remove('is-invalid');

          if (e.target.tomselect) {
            e.target.tomselect.wrapper.classList.remove('is-invalid');
          }
        });

        form.addEventListener('submit', e => {
          updateZoneOrders();
          updatePhotoOrders();

          clearInvalidState();

          const invalidFields = [...form.querySelectorAll('input, select, textarea')]
            .filter(field => {
              if (field.disabled || field.type === 'hidden' || field.type === 'file') return false;
              return !field.checkValidity();
            });

          if (!invalidFields.length) {
            return;
          }

          e.preventDefault();
          e.stopPropagation();

          const first = invalidFields[0];
          const labels = [...new Set(invalidFields.map(getFieldLabel))].slice(0, 8);

          invalidFields.forEach(markInvalid);

          errorAlert.querySelector('.js-premium-error-text').innerHTML = `
            <div class="mb-2">
              ${invalidFields.length} champ${invalidFields.length > 1 ? 's' : ''} à vérifier avant de pouvoir enregistrer le chantier.
            </div>
            <ul class="mb-0 ps-3">
              ${labels.map(label => `<li>${label}</li>`).join('')}
            </ul>
          `;

          errorAlert.classList.remove('d-none');

          setTimeout(() => {
            first.scrollIntoView({ behavior: 'smooth', block: 'center' });
            first.focus({ preventScroll: true });
          }, 250);
        }, true);
      }

      [fields.nom, fields.ville].forEach(el => {
        el?.addEventListener('input', refreshResume);
        el?.addEventListener('change', refreshResume);
      });


      [codeChantierEl, nominationChantierEl].forEach(el => {
        el?.addEventListener('input', refreshResume);
        el?.addEventListener('change', refreshResume);
      });

      fields.statut?.addEventListener('change', refreshResume);



