{% extends 'base_admin.html.twig' %}
{% block title %}Ajout d’un relevé d’utilisation{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/formulaire.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
      --bg:#f5f7fb;
      --panel:#fff;
      --ink:#0f172a;
      --muted:#64748b;
      --stroke:rgba(15,23,42,.10);
      --shadow:0 18px 55px rgba(15,23,42,.10);
      --radius:18px;
    }

    body{
      background:
        radial-gradient(900px 380px at 20% 0%, color-mix(in srgb, var(--theme-color-secondaire) 10%, transparent), transparent 60%),
        radial-gradient(900px 380px at 90% 10%, color-mix(in srgb, var(--theme-color-principal) 10%, transparent), transparent 60%),
        var(--bg);
    }

    .hero{
      border-radius:22px;
      position:relative;
      overflow:hidden;
      color:#fff;
      box-shadow:0 18px 50px rgba(0,0,0,.14);
      background:
        radial-gradient(1200px 420px at 12% -10%, color-mix(in srgb, var(--theme-color-tertiaire) 35%, transparent), transparent 58%),
        radial-gradient(900px 380px at 92% 0%, color-mix(in srgb, var(--theme-color-secondaire) 32%, transparent), transparent 60%),
        linear-gradient(135deg, color-mix(in srgb, var(--theme-color-principal) 92%, #000 8%), color-mix(in srgb, var(--theme-color-principal) 70%, #fff 30%));
    }

    .hero .accent{
      width:12px;
      border-radius:999px;
      background:var(--theme-color-secondaire);
      box-shadow:0 0 0 6px color-mix(in srgb, var(--theme-color-secondaire) 18%, transparent);
      flex:0 0 auto;
    }

    .hero .chip{
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      padding:.32rem .7rem;
      border-radius:999px;
      background:rgba(255,255,255,.10);
      border:1px solid rgba(255,255,255,.14);
      font-size:.82rem;
      color:rgba(255,255,255,.92);
      backdrop-filter:blur(6px);
      white-space:nowrap;
    }

    .hero .chip i{ color:var(--theme-color-secondaire); }
    .hero .chip--pill{
      background:color-mix(in srgb, var(--theme-color-secondaire) 18%, transparent);
      color:#fff;
    }

    .cardx{
      background:var(--panel);
      border:1px solid var(--stroke);
      border-radius:var(--radius);
      box-shadow:0 10px 28px rgba(15,23,42,.08);
      overflow:visible;
    }

    .cardx-h{
      padding:.95rem 1.05rem;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:1rem;
      background:linear-gradient(180deg, rgba(0,0,0,.015), transparent);
      border-bottom:1px solid var(--stroke);
    }

    .cardx-title{
      margin:0;
      font-weight:900;
      color:var(--ink);
      display:flex;
      align-items:center;
      gap:.6rem;
    }

    .cardx-title i{
      width:34px;
      height:34px;
      display:inline-grid;
      place-items:center;
      border-radius:12px;
      background:color-mix(in srgb, var(--theme-color-secondaire) 18%, #fff);
      border:1px solid color-mix(in srgb, var(--theme-color-secondaire) 22%, var(--stroke));
    }

    .chip-soft{
      font-size:.78rem;
      padding:.25rem .55rem;
      border-radius:999px;
      background:color-mix(in srgb, var(--theme-color-principal) 10%, transparent);
      border:1px solid color-mix(in srgb, var(--theme-color-principal) 18%, var(--stroke));
      color:var(--muted);
      white-space:nowrap;
    }

    label.form-label{ font-weight:800; color:var(--ink); }

    .form-control,
    .form-select{
      border-radius:14px;
      border:1px solid var(--stroke);
      padding:.65rem .85rem;
    }

    .form-control:focus,
    .form-select:focus{
      border-color:color-mix(in srgb, var(--theme-color-principal) 55%, var(--stroke));
      box-shadow:0 0 0 .2rem color-mix(in srgb, var(--theme-color-principal) 18%, transparent);
    }

    .btn-gradient{
      border:0;
      color:#fff;
      background:linear-gradient(135deg,
        color-mix(in srgb, var(--theme-color-principal) 90%, #000 10%),
        color-mix(in srgb, var(--theme-color-principal) 55%, var(--theme-color-secondaire) 45%)
      );
      box-shadow:0 14px 30px rgba(15,23,42,.14);
      font-weight:900;
    }

    .sticky-actions{
      position:sticky;
      bottom:14px;
      z-index:5;
      background:color-mix(in srgb, var(--panel) 82%, transparent);
      backdrop-filter:blur(10px);
      border:1px solid var(--stroke);
      border-radius:var(--radius);
      padding:.75rem;
      box-shadow:var(--shadow);
    }

    .ts-wrapper .ts-control{
      border-radius:14px!important;
      padding:.55rem .75rem!important;
      border-color:var(--stroke)!important;
    }

    .ts-dropdown{ z-index:9999!important; }

    @media(max-width:768px){
      .hero{ border-radius:16px; }
    }
  </style>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="{{ asset('dist/vendors/flatpickr/flatpickr.min.js')}}"></script>
  <script src="https://npmcdn.com/flatpickr/dist/l10n/fr.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
{% endblock %}

{% block body %}

<div class="hero p-3 mb-4 d-flex gap-3">
  <div class="accent"></div>

  <div class="flex-grow-1 position-relative" style="z-index:1">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
      <div>
        <h2 class="m-0 fw-bold">
          <i class="bi bi-speedometer2 me-2" style="color:var(--theme-color-secondaire)"></i>
          Ajouter un relevé d’utilisation
        </h2>
        <div class="opacity-75 mt-1">Saisie d’un nombre d’heures ou de kilomètres selon l’engin.</div>

        <div class="d-flex flex-wrap gap-2 mt-3">
          <span class="chip"><i class="bi bi-truck"></i> Engin</span>
          <span class="chip"><i class="bi bi-building"></i> {{ entite.nom }}</span>
          <span class="chip chip--pill"><i class="bi bi-plus-circle"></i> Nouveau relevé</span>
        </div>
      </div>

      <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-light btn-sm fw-semibold"
           href="{{ path('app_administrateur_engin_usage_index', { entite: entite.id }) }}">
          <i class="bi bi-arrow-left me-1"></i> Retour
        </a>

        <button form="{{ form.vars.id }}" type="submit" class="btn btn-light btn-sm fw-semibold">
          <i class="bi bi-check2 me-1"></i> Enregistrer
        </button>
      </div>
    </div>
  </div>
</div>

{% include 'flagMessage.html.twig' %}

{{ form_start(form, { attr: { id: form.vars.id, novalidate: 'novalidate', name: 'engin_usage_releve' } }) }}
{{ form_errors(form) }}

<div class="row g-4">
  <div class="col-lg-8">
    <div class="cardx mb-4">
      <div class="cardx-h">
        <h5 class="cardx-title">
          <i class="bi bi-pencil-square text-warning"></i> Relevé
        </h5>
        <span class="chip-soft">Saisie</span>
      </div>

      <div class="p-3 p-md-4">
        <div class="row g-3">
          <div class="col-md-12">
            {{ form_row(form.engin) }}
          </div>

          <div class="col-md-6">
            {{ form_row(form.dateReleve) }}
          </div>

          <div class="col-md-6">
            {{ form_row(form.valeur) }}
            <div class="form-text" id="unitHint">Sélectionne un engin pour connaître l’unité attendue.</div>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3 mb-3">
      <a href="{{ path('app_administrateur_engin_usage_index', { entite: entite.id }) }}" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Retour
      </a>

      <button type="submit" class="btn btn-gradient">
        <i class="bi bi-check2"></i> Ajouter le relevé
      </button>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="cardx mb-4">
      <div class="cardx-h">
        <h5 class="cardx-title">
          <i class="bi bi-clipboard2-check text-warning"></i> Résumé
        </h5>
        <span class="chip-soft">Contrôle</span>
      </div>

      <div class="p-3 p-md-4">
        <div class="small text-muted mb-3">Vérifie avant d’enregistrer.</div>

        <div class="border rounded-4 p-3 mb-3"
             style="border-color:var(--stroke)!important;background:linear-gradient(180deg,color-mix(in srgb,var(--theme-color-principal) 8%,transparent),transparent);">
          <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
            <div class="fw-bold">Relevé</div>
            <span id="resume-valid-pill"
                  class="badge rounded-pill px-3 py-2"
                  style="border:1px solid var(--stroke);background:rgba(255,193,7,.15);color:var(--ink);">
              ⚠️ Incomplet
            </span>
          </div>

          <div class="mt-3 small">
            <div class="d-flex justify-content-between gap-3 py-1">
              <span class="text-muted">Engin</span>
              <span class="fw-semibold text-end" id="resume-engin">-</span>
            </div>
            <div class="d-flex justify-content-between gap-3 py-1">
              <span class="text-muted">Unité</span>
              <span class="fw-semibold text-end" id="resume-unite">-</span>
            </div>
            <div class="d-flex justify-content-between gap-3 py-1">
              <span class="text-muted">Valeur</span>
              <span class="fw-semibold text-end" id="resume-valeur">-</span>
            </div>
          </div>
        </div>

        <div class="d-flex gap-2">
          <a class="btn btn-light w-50"
             href="{{ path('app_administrateur_engin_usage_index', { entite: entite.id }) }}">
            Annuler
          </a>

          <button type="submit" class="btn btn-gradient w-50">
            <i class="bi bi-check2"></i> Enregistrer
          </button>
        </div>
      </div>
    </div>

    <div class="sticky-actions d-none d-lg-block">
      <div class="d-flex align-items-center justify-content-between gap-2">
        <div class="small text-muted">
          <strong class="text-dark">Astuce :</strong> l’unité dépend du paramètre de l’engin.
        </div>
        <button type="submit" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-check2"></i>
        </button>
      </div>
    </div>
  </div>
</div>

{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', () => {
  const enginUnits = {
    {% for engin in engins %}
      "{{ engin.id }}": "{{ engin.compteurType.value == 'kilometre' ? 'km' : 'h' }}",
    {% endfor %}
  };

  const enginSelect = document.getElementById('{{ form.engin.vars.id }}');
  const valeurInput = document.getElementById('{{ form.valeur.vars.id }}');

  const resume = {
    engin: document.getElementById('resume-engin'),
    unite: document.getElementById('resume-unite'),
    valeur: document.getElementById('resume-valeur'),
    pill: document.getElementById('resume-valid-pill'),
    hint: document.getElementById('unitHint')
  };

  if (window.flatpickr && window.flatpickr.l10ns && window.flatpickr.l10ns.fr) {
    flatpickr.localize(flatpickr.l10ns.fr);
  }

  if (window.flatpickr) {
    document.querySelectorAll('.js-flatpickr').forEach(el => {
      flatpickr(el, {
        dateFormat: 'Y-m-d',
        altInput: true,
        altFormat: 'd/m/Y',
        allowInput: true
      });
    });
  }

  if (enginSelect && !enginSelect.tomselect) {
    new TomSelect(enginSelect, {
      dropdownParent: 'body',
      create: false,
      allowEmptyOption: true,
      sortField: { field: 'text', direction: 'asc' },
      onChange: refreshResume
    });
  }

  function selectedText(selectEl){
    if (!selectEl || !selectEl.value) return '';
    const opt = selectEl.selectedOptions && selectEl.selectedOptions[0];
    return opt ? opt.textContent.trim() : '';
  }

  function refreshResume(){
    const enginId = enginSelect?.value || '';
    const unit = enginUnits[enginId] || '';
    const valeur = valeurInput?.value || '';

    if (resume.engin) resume.engin.textContent = selectedText(enginSelect) || '-';
    if (resume.unite) resume.unite.textContent = unit || '-';
    if (resume.valeur) resume.valeur.textContent = valeur ? `${valeur} ${unit}` : '-';
    if (resume.hint) resume.hint.textContent = unit ? `Valeur attendue en ${unit}.` : 'Sélectionne un engin pour connaître l’unité attendue.';

    const ok = !!enginId && !!valeur;

    if (resume.pill) {
      if (ok) {
        resume.pill.textContent = '✅ Complet';
        resume.pill.style.background = 'rgba(25,135,84,.15)';
        resume.pill.style.borderColor = 'rgba(25,135,84,.35)';
      } else {
        resume.pill.textContent = '⚠️ Incomplet';
        resume.pill.style.background = 'rgba(255,193,7,.15)';
        resume.pill.style.borderColor = 'rgba(255,193,7,.35)';
      }
    }
  }

  enginSelect?.addEventListener('change', refreshResume);
  valeurInput?.addEventListener('input', refreshResume);
  valeurInput?.addEventListener('change', refreshResume);

  refreshResume();
});
</script>
{% endblock %}