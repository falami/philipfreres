{% extends 'base_admin.html.twig' %}
{% block title %}Dashboard utilisation engins{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/formulaire.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
      --bg:#f5f7fb; --panel:#fff; --ink:#0f172a; --muted:#64748b;
      --stroke:rgba(15,23,42,.10); --shadow:0 18px 55px rgba(15,23,42,.10);
      --radius:18px;
    }

    body{
      background:
        radial-gradient(900px 380px at 20% 0%, color-mix(in srgb, var(--theme-color-secondaire) 10%, transparent), transparent 60%),
        radial-gradient(900px 380px at 90% 10%, color-mix(in srgb, var(--theme-color-principal) 10%, transparent), transparent 60%),
        var(--bg);
    }

    .hero{border-radius:22px;position:relative;overflow:hidden;color:#fff;box-shadow:0 18px 50px rgba(0,0,0,.14);
      background:
        radial-gradient(1200px 420px at 12% -10%, color-mix(in srgb,var(--theme-color-tertiaire) 35%,transparent), transparent 58%),
        radial-gradient(900px 380px at 92% 0%, color-mix(in srgb,var(--theme-color-secondaire) 32%,transparent), transparent 60%),
        linear-gradient(135deg, color-mix(in srgb,var(--theme-color-principal) 92%,#000 8%), color-mix(in srgb,var(--theme-color-principal) 70%,#fff 30%));
    }
    .hero .accent{width:12px;border-radius:999px;background:var(--theme-color-secondaire);box-shadow:0 0 0 6px color-mix(in srgb,var(--theme-color-secondaire) 18%,transparent);}
    .hero .chip{display:inline-flex;align-items:center;gap:.5rem;padding:.32rem .7rem;border-radius:999px;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.14);font-size:.82rem;color:rgba(255,255,255,.92);backdrop-filter:blur(6px);white-space:nowrap;}
    .hero .chip i{color:var(--theme-color-secondaire);}

    .cardx{background:var(--panel);border:1px solid var(--stroke);border-radius:var(--radius);box-shadow:0 10px 28px rgba(15,23,42,.08);overflow:visible;}
    .cardx-h{padding:1rem 1.1rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--stroke);}
    .cardx-title{margin:0;font-weight:900;color:var(--ink);display:flex;align-items:center;gap:.6rem;}
    .cardx-title i{width:34px;height:34px;display:inline-grid;place-items:center;border-radius:12px;background:color-mix(in srgb,var(--theme-color-secondaire) 18%,#fff);border:1px solid color-mix(in srgb,var(--theme-color-secondaire) 22%,var(--stroke));}

    .chip{font-size:.78rem;padding:.25rem .55rem;border-radius:999px;background:color-mix(in srgb,var(--theme-color-principal) 10%,transparent);border:1px solid color-mix(in srgb,var(--theme-color-principal) 18%,var(--stroke));color:var(--muted);white-space:nowrap;}

    .toolbar{border-radius:16px;background:#fff;border:1px solid var(--stroke);box-shadow:0 10px 24px rgba(0,0,0,.05);padding:.85rem;}
    .toolbar .filter-chip{display:inline-flex;align-items:center;gap:.5rem;padding:.45rem .7rem;border-radius:999px;background:rgba(0,0,0,.03);border:1px solid rgba(0,0,0,.06);}
    .toolbar .form-control,.toolbar .form-select{border-radius:12px;border:1px solid var(--stroke);}

    .btn-gradient{border:0;color:#fff;font-weight:900;background:linear-gradient(135deg,color-mix(in srgb,var(--theme-color-principal) 90%,#000 10%),color-mix(in srgb,var(--theme-color-principal) 55%,var(--theme-color-secondaire) 45%));box-shadow:0 14px 30px rgba(15,23,42,.14);}

    .kpi-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:12px;}
    .kpi{grid-column:span 3;padding:16px;border:1px solid var(--stroke);border-radius:20px;background:#fff;box-shadow:0 10px 28px rgba(15,23,42,.06);}
    .kpi .label{color:var(--muted);font-size:.82rem;font-weight:900;text-transform:uppercase;letter-spacing:.04em;}
    .kpi .value{font-weight:950;font-size:1.45rem;color:var(--ink);text-align:center;}
    .kpi .sub{color:var(--muted);font-size:.82rem;text-align:center;}
    .kpi .ico{width:38px;height:38px;border-radius:14px;display:grid;place-items:center;background:color-mix(in srgb,var(--theme-color-principal) 10%,#fff);border:1px solid var(--stroke);color:var(--theme-color-secondaire);}
    @media(max-width:1200px){.kpi{grid-column:span 6;}}
    @media(max-width:768px){.kpi{grid-column:span 12;}.hero{border-radius:16px;}}

    .chart-box{height:360px;border-radius:18px;border:1px dashed color-mix(in srgb,var(--theme-color-principal) 22%,var(--stroke));background:#fff;padding:12px;}
    .chart-box.sm{height:330px;}
  </style>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="https://npmcdn.com/flatpickr/dist/l10n/fr.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
{% endblock %}

{% block body %}

<div class="hero p-3 mb-4 d-flex gap-3">
  <div class="accent"></div>
  <div class="flex-grow-1">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
      <div>
        <h2 class="m-0 fw-bold">
          <i class="bi bi-speedometer2 me-2" style="color:var(--theme-color-secondaire)"></i>
          Dashboard utilisation engins
        </h2>
        <div class="opacity-75 mt-1">Analyse automatique heures/km + dépenses importées ALX, TOTAL, EDENRED et notes.</div>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <span class="chip"><i class="bi bi-truck"></i> Utilisation</span>
          <span class="chip"><i class="bi bi-cash-stack"></i> Dépenses auto</span>
          <span class="chip"><i class="bi bi-building"></i> {{ entite.nom }}</span>
        </div>
      </div>

      <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-light btn-sm fw-semibold" href="{{ path('app_administrateur_engin_usage_ajouter', { entite: entite.id }) }}">
          <i class="bi bi-plus-circle me-1"></i> Nouveau relevé
        </a>
        <a class="btn btn-outline-light btn-sm fw-semibold" href="{{ path('app_administrateur_engin_usage_index', { entite: entite.id }) }}">
          <i class="bi bi-list-ul me-1"></i> Relevés
        </a>
      </div>
    </div>
  </div>
</div>

<div class="toolbar mb-4">
  <div class="d-flex flex-wrap gap-2 align-items-center">
    <span class="filter-chip">
      <i class="bi bi-calendar3"></i>
      <input type="text" id="fStart" class="form-control form-control-sm" value="{{ start }}" style="width:130px">
      <input type="text" id="fEnd" class="form-control form-control-sm" value="{{ end }}" style="width:130px">
    </span>

    <span class="filter-chip">
      <i class="bi bi-truck-front"></i>
      <select id="fEngin" class="form-select form-select-sm" style="min-width:280px">
        <option value="">Tous les engins</option>
        {% for engin in engins %}
          <option value="{{ engin.id }}" {% if selectedEnginId == engin.id %}selected{% endif %}>
            {{ engin.nom }}{% if engin.immatriculation %} - {{ engin.immatriculation }}{% endif %}
          </option>
        {% endfor %}
      </select>
    </span>

    <div class="ms-auto d-flex gap-2">
      <button class="btn btn-outline-secondary btn-sm fw-semibold" id="btnReset" type="button">
        <i class="bi bi-arrow-counterclockwise"></i> Reset
      </button>
      <button class="btn btn-gradient btn-sm" id="btnRefresh" type="button">
        <i class="bi bi-arrow-repeat"></i> Actualiser
      </button>
    </div>
  </div>
</div>

<div class="cardx mb-4">
  <div class="cardx-h">
    <h5 class="cardx-title"><i class="bi bi-speedometer2 text-warning"></i> Indicateurs</h5>
    <span class="chip">Auto</span>
  </div>
  <div class="p-3 p-md-4">
    <div class="kpi-grid">
      <div class="kpi">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <div class="label">Utilisation totale</div>
          <div class="ico"><i class="bi bi-activity"></i></div>
        </div>
        <div class="value" id="kpiUsage">-</div>
        <div class="sub">heures + kilomètres</div>
      </div>

      <div class="kpi">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <div class="label">Dépenses</div>
          <div class="ico"><i class="bi bi-cash-stack"></i></div>
        </div>
        <div class="value" id="kpiDepense">-</div>
        <div class="sub">imports rattachés engins</div>
      </div>

      <div class="kpi">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <div class="label">Moyenne</div>
          <div class="ico"><i class="bi bi-graph-up"></i></div>
        </div>
        <div class="value" id="kpiAvg">-</div>
        <div class="sub">par relevé</div>
      </div>

      <div class="kpi">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <div class="label">Coût / unité</div>
          <div class="ico"><i class="bi bi-calculator"></i></div>
        </div>
        <div class="value" id="kpiCostUnit">-</div>
        <div class="sub">€/h ou €/km moyen</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-12">
    <div class="cardx">
      <div class="cardx-h">
        <h5 class="cardx-title"><i class="bi bi-activity text-warning"></i> Utilisation mensuelle</h5>
        <span class="chip">Heures / km</span>
      </div>
      <div class="p-3 p-md-4">
        <div class="chart-box"><canvas id="chMonthlyUsage"></canvas></div>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="cardx">
      <div class="cardx-h">
        <h5 class="cardx-title"><i class="bi bi-cash-coin text-warning"></i> Utilisation hebdomadaire</h5>
        <span class="chip">€</span>
      </div>
      <div class="p-3 p-md-4">
        <div class="chart-box sm"><canvas id="chMonthlyDepense"></canvas></div>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="cardx">
      <div class="cardx-h">
        <h5 class="cardx-title"><i class="bi bi-truck-front-fill text-warning"></i> Top engins utilisés</h5>
        <span class="chip">Top 10</span>
      </div>
      <div class="p-3 p-md-4">
        <div class="chart-box sm"><canvas id="chTopEngin"></canvas></div>
      </div>
    </div>
  </div>

  <div class="col-lg-12">
    <div class="cardx">
      <div class="cardx-h">
        <h5 class="cardx-title"><i class="bi bi-calculator text-warning"></i> Moyenne journalière par engin</h5>
        <span class="chip">€/h ou €/km</span>
      </div>
      <div class="p-3 p-md-4">
        <div class="chart-box"><canvas id="chCostUnit"></canvas></div>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  if (window.flatpickr && window.flatpickr.l10ns?.fr) {
    flatpickr.localize(flatpickr.l10ns.fr);
  }

  const money = v => new Intl.NumberFormat('fr-FR', {style:'currency', currency:'EUR'}).format(Number(v || 0));
  const num = (v, d = 2) => new Intl.NumberFormat('fr-FR', {minimumFractionDigits:d, maximumFractionDigits:d}).format(Number(v || 0));

  const $start = document.getElementById('fStart');
  const $end = document.getElementById('fEnd');
  const $engin = document.getElementById('fEngin');

  flatpickr($start, { dateFormat:'Y-m-d', altInput:true, altFormat:'d/m/Y', allowInput:true });
  flatpickr($end, { dateFormat:'Y-m-d', altInput:true, altFormat:'d/m/Y', allowInput:true });

  if ($engin && !$engin.tomselect) {
    new TomSelect($engin, { dropdownParent:'body', create:false, allowEmptyOption:true });
  }

  let chMonthlyUsage = null;
  let chMonthlyDepense = null;
  let chTopEngin = null;
  let chCostUnit = null;

  function filters(){
    return {
      dateStart: $start.value,
      dateEnd: $end.value,
      enginId: $engin?.tomselect ? $engin.tomselect.getValue() : $engin.value
    };
  }

  function chart(ref, canvasId, cfg){
    if (ref) ref.destroy();
    return new Chart(document.getElementById(canvasId), cfg);
  }

  async function refresh(){
    const query = new URLSearchParams(filters()).toString();
    const res = await fetch("{{ path('app_administrateur_engin_usage_api_dashboard', { entite: entite.id }) }}?" + query);
    const data = await res.json();

    document.getElementById('kpiUsage').textContent = num(data.kpis.totalUsage);
    document.getElementById('kpiAvg').textContent = num(data.kpis.avgDaily);
    document.getElementById('kpiDepense').textContent = num(data.kpis.avgWeekly);
    document.getElementById('kpiCostUnit').textContent = num(data.kpis.avgMonthly);
    
    const usageLabels = data.charts.monthlyUsage.map(x => x.month);

    chMonthlyUsage = chart(chMonthlyUsage, 'chMonthlyUsage', {
      type:'line',
      data:{
        labels: usageLabels,
        datasets:[{
          label:'Utilisation réelle mensuelle',
          data:data.charts.monthlyUsage.map(x => x.usage),
          tension:.35,
          fill:true
        }]
      },
      options:{responsive:true, maintainAspectRatio:false}
    });

    const weeklyLabels = data.charts.weeklyUsage.map(x => x.week);

    chMonthlyDepense = chart(chMonthlyDepense, 'chMonthlyDepense', {
      type:'bar',
      data:{
        labels: weeklyLabels,
        datasets:[{
          label:'Utilisation hebdomadaire',
          data:data.charts.weeklyUsage.map(x => x.usage)
        }]
      },
      options:{responsive:true, maintainAspectRatio:false}
    });

    const top = data.charts.byEngin
      .sort((a,b) => Number(b.usage) - Number(a.usage))
      .slice(0, 10);

    chTopEngin = chart(chTopEngin, 'chTopEngin', {
      type:'bar',
      data:{
        labels:top.map(x => x.engin),
        datasets:[{
          label:'Utilisation réelle',
          data:top.map(x => x.usage)
        }]
      },
      options:{indexAxis:'y', responsive:true, maintainAspectRatio:false}
    });

    const averages = data.charts.byEngin
      .sort((a,b) => Number(b.avgDaily) - Number(a.avgDaily))
      .slice(0, 15);

    chCostUnit = chart(chCostUnit, 'chCostUnit', {
      type:'bar',
      data:{
        labels:averages.map(x => x.engin),
        datasets:[{
          label:'Moyenne journalière',
          data:averages.map(x => x.avgDaily)
        }]
      },
      options:{responsive:true, maintainAspectRatio:false}
    });
  }

  document.getElementById('btnRefresh')?.addEventListener('click', refresh);

  document.getElementById('btnReset')?.addEventListener('click', () => {
    $start.value = "{{ start }}";
    $end.value = "{{ end }}";
    if ($engin?.tomselect) $engin.tomselect.clear();
    else $engin.value = '';
    refresh();
  });

  refresh();
})();
</script>

{% endblock %}