<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Votre échéance de marché</title></head>
<body style="margin:0;background:#f3f5ef;font-family:Arial,Helvetica,sans-serif;color:#203c32">
<div style="display:none;max-height:0;overflow:hidden">{{ market.title }} — réponse attendue le {{ deadline|date('d/m/Y à H:i', 'Europe/Paris') }}.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:32px 12px">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#fff;border:1px solid #dfe5d9;border-radius:20px;overflow:hidden">
<tr><td style="padding:36px;background:#163e32;color:white"><p style="margin:0 0 26px;letter-spacing:3px;font-size:12px;color:#d6c18a">PHILIP FRÈRES · VEILLE MARCHÉS</p><h1 style="margin:0;font-family:Georgia,serif;font-size:32px;font-weight:normal">Une échéance à préparer.</h1><p style="margin:14px 0 0;color:#d9e5dc;font-size:15px">Votre sélection DoubleTrade, au bon moment.</p></td></tr>
<tr><td style="padding:32px 36px"><p style="font-size:15px">Bonjour {{ recipient.name }},</p><p style="line-height:1.7;color:#617268">La date limite de réception des offres approche pour le marché suivant.</p><h2 style="font-size:22px;line-height:1.4;margin:24px 0">{{ market.title }}</h2>
<table role="presentation" width="100%" style="background:#f4f3e9;border-left:4px solid #b49a59"><tr><td style="padding:20px"><p style="margin:0 0 8px;font-size:11px;letter-spacing:2px;color:#6b725e">DATE LIMITE DE RÉPONSE</p><strong style="font-size:23px">{{ deadline|date('d/m/Y', 'Europe/Paris') }}</strong><br><span style="line-height:2">{{ deadline|date('H:i', 'Europe/Paris') }} · Heure de Paris</span></td></tr></table>
<p style="line-height:1.8"><strong>Acheteur</strong><br>{{ market.buyer ?: 'Non renseigné' }}</p>
{% if contract.reference|default('') %}<p><strong>Référence</strong><br>{{ contract.reference }}</p>{% endif %}
{% if contract.completeObject|default('') %}<p style="line-height:1.7;color:#617268">{{ contract.completeObject|striptags|slice(0, 1800) }}</p>{% endif %}
{% set amount = contract.estimatedAmountExcludingTax|default(contract.estimatedAmount|default({})) %}
{% if amount.singleValue is defined %}<p><strong>Montant estimé</strong><br>{{ amount.singleValue|number_format(2, ',', ' ') }} {{ amount.currencyCode|default('') }}</p>{% endif %}
<p style="margin:30px 0"><a href="{{ url }}" style="display:inline-block;background:#163e32;color:#fff;text-decoration:none;padding:17px 26px;border-radius:8px;font-weight:bold">Consulter la fiche complète →</a></p>
<p style="font-size:12px;line-height:1.7;color:#7a867c">Les informations et pièces de référence restent celles publiées par l’acheteur. Vérifiez les éventuels reports avant de déposer votre offre. La fiche est réservée aux administrateurs habilités ; les informations essentielles figurent dans ce message.</p></td></tr>
<tr><td style="padding:22px 36px;background:#f6f7f2;font-size:12px;color:#7a867c;line-height:1.7">Philip Frères · L’exigence, naturellement.<br>Vous recevez ce rappel car votre dirigeant vous a sélectionné dans les paramètres des marchés suivis.</td></tr>
</table></td></tr></table></body></html>
