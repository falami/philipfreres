{% extends 'security/_auth_layout.html.twig' %}
{% block title %}Accès restreint · Philip Frères{% endblock %}
{% block auth_progress %}{% endblock %}
{% block auth_content %}
    <div class="auth-heading">
        <div class="auth-mail-mark" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path d="m16 3 11 4v7c0 7-4.7 11.5-11 14-6.3-2.5-11-7-11-14V7l11-4Z" stroke="currentColor" stroke-width="1.5"/><path d="M16 10v7m0 4h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></div>
        <p class="auth-eyebrow">Votre espace de travail</p>
        <h1>Votre accès<br>est restreint.</h1>
        <p>Votre compte est bien identifié, mais ses autorisations ne vous permettent pas d’accéder à cet espace.</p>
    </div>
    <div class="auth-notice">Contactez votre administrateur pour vérifier votre rattachement et les accès associés à votre compte.</div>
    <form action="{{ path('app_logout') }}" method="post" data-auth-form data-turbo="false">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button class="auth-button" type="submit" data-submit-button><span data-submit-label>Me déconnecter</span><span class="auth-button-arrow" aria-hidden="true">→</span><span class="auth-spinner" aria-hidden="true" hidden></span></button>
    </form>
    <p class="auth-form-caption">Vous pourrez ensuite vous connecter avec un autre compte.</p>
{% endblock %}
