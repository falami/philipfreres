{% extends 'security/_auth_layout.html.twig' %}
{% block title %}Connexion · Philip Frères{% endblock %}
{% block auth_step %}1{% endblock %}
{% block auth_content %}
    <div class="auth-heading">
        <p class="auth-eyebrow">Votre espace de travail</p>
        <h1>Heureux de vous<br>retrouver.</h1>
        <p>Connectez-vous pour retrouver votre équipe et vos activités.</p>
    </div>
    {% if error %}
        <div class="auth-notice auth-notice--error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    {% if app.user and is_granted('IS_AUTHENTICATED_REMEMBERED') %}
        <div class="auth-notice">Vous êtes connecté en tant que {{ app.user.userIdentifier }}.</div>
        <a class="auth-button" href="{{ path('app_workspace') }}">Accéder à mon espace <span aria-hidden="true">→</span></a>
        <form action="{{ path('app_logout') }}" method="post" class="auth-cancel-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button class="auth-text-button" type="submit">Me déconnecter</button>
        </form>
    {% else %}
        <form method="post" action="{{ path('app_login') }}" class="auth-form" data-auth-form data-turbo="false">
            <div class="auth-field">
                <label for="username">Adresse e-mail</label>
                <div class="auth-input-wrap">
                    <svg class="auth-icon auth-input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus placeholder="prenom@entreprise.fr">
                </div>
            </div>
            <div class="auth-field">
                <div class="auth-label-row">
                    <label for="password">Mot de passe</label>
                    <a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>
                </div>
                <div class="auth-input-wrap auth-input-wrap--password">
                    <svg class="auth-icon auth-input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    <input type="password" name="_password" id="password" autocomplete="current-password" required>
                    <button type="button" class="auth-password-toggle" data-password-toggle aria-controls="password" aria-label="Afficher le mot de passe" aria-pressed="false" hidden>
                        <svg class="auth-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/><path class="auth-eye-slash" d="m4 3 16 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    </button>
                </div>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <div class="auth-remember">
                <input type="checkbox" name="_remember_me" value="1" id="remember-me" checked aria-describedby="remember-help">
                <div><label for="remember-me">Rester connecté sur cet appareil pendant 90 jours</label><p id="remember-help">Décochez cette option sur un appareil partagé.</p></div>
            </div>
            <button class="auth-button" type="submit" data-submit-button><span data-submit-label>Continuer</span><span class="auth-button-arrow" aria-hidden="true">→</span><span class="auth-spinner" aria-hidden="true" hidden></span></button>
            <p class="auth-form-caption"><svg class="auth-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3 8 3v5c0 5-3.4 8.3-8 10-4.6-1.7-8-5-8-10V6l8-3Z" stroke="currentColor" stroke-width="1.6"/><path d="m8.5 12 2.3 2.3 4.7-4.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Un code envoyé par e-mail confirmera votre connexion.</p>
        </form>
    {% endif %}
{% endblock %}
