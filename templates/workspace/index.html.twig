<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="same-origin">
  <title>Votre espace · Philip Frères</title>
  <link rel="icon" href="{{ asset('uploads/photos/entite/favicon/favicon-philip-freres.webp') }}">
  <style>
    :root{color-scheme:light;--forest:#12372f;--ink:#203a32;--muted:#65736a;--border:#d9e1d8;--gold:#d9bd87}
    *{box-sizing:border-box}body{margin:0;background:#f9faf5;color:var(--ink);font:16px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:inherit}button{font:inherit;cursor:pointer}a:focus-visible,button:focus-visible{outline:3px solid #9b7134;outline-offset:4px}.skip{position:absolute;left:20px;top:-80px;background:white;padding:12px;z-index:2}.skip:focus{top:12px}
    .shell{max-width:1180px;margin:0 auto;padding:0 40px}.header{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:112px;border-bottom:1px solid var(--border)}.brand{display:flex;align-items:center;gap:15px;text-decoration:none;font-size:13px;letter-spacing:.12em;font-weight:700;text-transform:uppercase}.brand img{width:52px;height:52px;object-fit:contain;border-radius:5px}.session{display:flex;align-items:center;gap:24px}.status{font-size:12px;color:var(--muted);display:flex;gap:8px;align-items:center}.dot{width:7px;height:7px;border-radius:50%;background:#507b63}.logout{background:transparent;border:1px solid var(--border);border-radius:7px;color:var(--ink);padding:9px 15px;font-size:13px}.logout:hover{background:#edf1e8}
    main{padding:72px 0 88px}.eyebrow{text-transform:uppercase;letter-spacing:.17em;font-size:11px;font-weight:700;color:var(--muted);margin:0 0 20px}.welcome{display:flex;justify-content:space-between;gap:32px;align-items:end;margin-bottom:46px}h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(34px,5vw,54px);font-weight:400;letter-spacing:-.04em;line-height:1.12;margin:0 0 18px;max-width:800px}.lead{margin:0;color:var(--muted);max-width:600px}.count{font-size:12px;white-space:nowrap;color:var(--muted);border-bottom:1px solid var(--gold);padding-bottom:6px}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,295px),1fr));gap:24px}.card{border:1px solid var(--border);border-radius:12px;background:#fff;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 8px 26px rgba(18,55,47,.025)}.card-main{padding:30px;flex:1}.card-heading{display:flex;justify-content:space-between;align-items:start;gap:15px;margin-bottom:25px}.monogram{width:54px;height:54px;border:1px solid var(--border);border-radius:8px;display:grid;place-items:center;background:#f3f5ef;color:var(--forest);font-family:Georgia,serif;font-size:24px;overflow:hidden}.monogram img{width:100%;height:100%;object-fit:contain;background:white}.active{font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:#3c6e55;border-radius:50px;background:#eef4ec;padding:4px 9px}.card h2{font-size:22px;font-weight:600;line-height:1.3;letter-spacing:-.025em;margin:0 0 12px;overflow-wrap:anywhere}.roles{display:flex;gap:6px;flex-wrap:wrap}.role{font-size:12px;color:var(--muted)}.role+.role:before{content:"·";margin-right:6px}.card form{padding:0 30px 30px}.enter{display:flex;justify-content:space-between;align-items:center;gap:12px;width:100%;background:var(--forest);color:white;border:1px solid var(--forest);border-radius:7px;padding:13px 16px;text-align:left;font-size:14px;font-weight:600}.enter:hover{background:#205044}.enter svg{width:17px;height:17px;flex:none}
    .empty{display:grid;grid-template-columns:90px 1fr;gap:26px;border:1px solid var(--border);border-radius:12px;padding:42px;background:white;max-width:900px}.empty-icon{width:72px;height:72px;display:grid;place-items:center;border:1px solid var(--border);border-radius:50%;color:var(--forest);background:#f4f6ef}.empty-icon svg{width:30px;height:30px}.empty h2{font:400 29px/1.25 Georgia,serif;margin:0 0 16px}.empty p{color:var(--muted);margin:0 0 16px;max-width:600px}.email{display:inline-block;max-width:100%;overflow-wrap:anywhere;color:var(--ink);font-size:14px;background:#f4f6ef;border:1px solid var(--border);padding:9px 13px;border-radius:7px}.note{font-size:13px;color:var(--muted);margin-top:30px;max-width:680px}.footer{border-top:1px solid var(--border);padding:24px 0 36px;display:flex;justify-content:space-between;gap:20px;font-size:11px;color:var(--muted);letter-spacing:.03em}.footer a{text-underline-offset:4px}
    @media(max-width:640px){.shell{padding:0 22px}.header{min-height:92px;gap:12px}.brand{font-size:10px;letter-spacing:.06em;gap:9px}.brand img{width:42px;height:42px}.status{display:none}.logout{font-size:12px;padding:8px 10px}main{padding:48px 0 58px}.welcome{display:block;margin-bottom:30px}.count{display:inline-block;margin-top:22px}.card-main{padding:24px}.card form{padding:0 24px 24px}.empty{display:block;padding:28px}.empty-icon{margin-bottom:24px}.footer{flex-wrap:wrap}}
  </style>
</head>
<body>
<a class="skip" href="#main">Aller au contenu</a>
<div class="shell">
  <header class="header">
    <a class="brand" href="{{ path('app_workspace') }}" aria-label="Philip Frères, votre espace">
      <img src="{{ asset('uploads/photos/entite/logo/logo-philip-freres.jpg') }}" alt="" width="52" height="52">
      <span>Philip Frères<br><span style="font-weight:400;letter-spacing:.05em">Espace professionnel</span></span>
    </a>
    <div class="session">
      <span class="status"><span class="dot" aria-hidden="true"></span>Compte connecté</span>
      <form action="{{ path('app_logout') }}" method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button class="logout" type="submit">Se déconnecter</button>
      </form>
    </div>
  </header>
  <main id="main">
    <p class="eyebrow">Votre espace de travail</p>
    <div class="welcome">
      <div>
        <h1>Bonjour{% if user.prenom %}, {{ user.prenom }}{% endif %}.</h1>
        <p class="lead">{% if memberships is not empty %}Choisissez votre entité pour retrouver vos équipes, vos chantiers et vos outils.{% else %}Votre connexion est établie. Il reste à activer votre accès à une entité.{% endif %}</p>
      </div>
      {% if memberships is not empty %}<span class="count">{{ memberships|length }} espace{{ memberships|length > 1 ? 's' : '' }} disponible{{ memberships|length > 1 ? 's' : '' }}</span>{% endif %}
    </div>
    {% if memberships is empty %}
      <section class="empty" aria-labelledby="pending-title">
        <div class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 21V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v17M3 21h18M9 21v-5h6v5M8 7h2m4 0h2M8 11h2m4 0h2"/></svg></div>
        <div>
          <h2 id="pending-title">Votre accès est en attente.</h2>
          <p>Aucune entité active n’est associée à votre compte pour le moment. Contactez votre administrateur afin qu’il vous attribue les accès nécessaires.</p>
          <p>Communiquez-lui l’adresse de votre compte :</p>
          <span class="email">{{ user.email }}</span>
        </div>
      </section>
    {% else %}
      <div class="grid">
        {% for membership in memberships %}
          {% set entity = membership.entite %}
          <section class="card" aria-labelledby="entity-{{ entity.id }}">
            <div class="card-main">
              <div class="card-heading">
                <div class="monogram" aria-hidden="true">{% if entity.logo %}<img src="{{ asset('uploads/photos/entite/logo/' ~ entity.logo) }}" alt="" width="54" height="54">{% else %}{{ entity.nom|default('P', true)|slice(0,1)|upper }}{% endif %}</div>
                <span class="active">Accès actif</span>
              </div>
              <h2 id="entity-{{ entity.id }}">{{ entity.nom|default('Votre entité', true) }}</h2>
              <div class="roles">
                {% if membership.isTenantAdmin %}<span class="role">Administrateur</span>{% endif %}
                {% if membership.hasRole('TENANT_CHEF') %}<span class="role">Chef de chantier</span>{% endif %}
                {% if membership.hasRole('TENANT_EMPLOYE') %}<span class="role">Employé</span>{% endif %}
              </div>
            </div>
            <form method="post" action="{{ path('app_workspace_switch', {id: entity.id}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('switch_entite_' ~ entity.id) }}">
              <button type="submit" class="enter" aria-label="Ouvrir l’espace {{ entity.nom }}">Ouvrir cet espace<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></button>
            </form>
          </section>
        {% endfor %}
      </div>
      <p class="note">Un espace manque ? Votre administrateur peut vérifier votre rattachement et vos droits d’accès.</p>
    {% endif %}
  </main>
  <footer class="footer"><span>PHILIP FRÈRES · ESPACE PROFESSIONNEL</span><a href="{{ path('app_account_security') }}">Sécurité de mon compte</a><a href="{{ path('app_public') }}">Retour au site</a></footer>
</div>
</body>
</html>
