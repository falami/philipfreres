<a class="pf-skip-link" href="#pf-main">Aller au contenu</a>
<header class="pf-header">
 <div class="pf-header-context">
  <button type="button" class="pf-icon-button" id="pf-menu-toggle" aria-controls="pf-sidebar" aria-expanded="true" aria-label="Ouvrir ou réduire le menu"><i class="bi bi-layout-sidebar" aria-hidden="true"></i></button>
  <div class="pf-breadcrumb"><small>{{ navSection }}</small><strong>{{ navTitle }}</strong></div>
 </div>
 <nav class="pf-header-shortcuts" aria-label="Accès rapides">
 {% import 'navigation/tree.html.twig' as navigation %}
 {% for item in navItems %}
  {% if item.children is defined %}
   <details class="pf-header-dropdown pf-shortcut-menu"><summary class="{{ navSection == item.label ? 'is-current' : '' }}"><i class="bi bi-{{ item.icon }}" aria-hidden="true"></i>{{ item.label }}<i class="bi bi-chevron-down" aria-hidden="true"></i></summary><div class="pf-header-popover">{{ navigation.tree(item.children, entite, navRoute, navHasExact) }}</div></details>
  {% else %}
   <a href="{{ path(item.route, {entite: entite.id}) }}" class="{{ navSection == item.label ? 'is-current' : '' }}"><i class="bi bi-{{ item.icon }}" aria-hidden="true"></i>{{ item.label }}</a>
  {% endif %}
 {% endfor %}
 </nav>
 <div class="pf-header-actions">
  <details class="pf-header-dropdown"><summary class="pf-icon-button" aria-label="Choisir la langue">{{ app.request.locale|upper }}</summary><div class="pf-header-popover">
   {% for code, label in {fr: 'Français', en: 'English'} %}<a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({_locale: code})) }}" lang="{{ code }}" hreflang="{{ code }}">{{ label }}{% if app.request.locale == code %}<i class="bi bi-check2" aria-hidden="true"></i>{% endif %}</a>{% endfor %}
  </div></details>
  {% if canAdmin %}<a class="pf-icon-button pf-settings" href="{{ path('app_premium_entite_index', {id: entite.id, entite: entite.id}) }}" aria-label="Paramètres de l’entreprise" title="Paramètres de l’entreprise"><i class="bi bi-gear" aria-hidden="true"></i></a>{% endif %}
  <span class="pf-header-divider"></span>
  <details class="pf-header-dropdown pf-account"><summary aria-label="Menu du compte">
   <span class="pf-avatar">{% if app.user.photo %}<img src="{{ asset('uploads/photos/utilisateur/' ~ app.user.photo) }}" alt="">{% else %}{{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}{% endif %}</span>
   <span class="pf-account-name"><strong>{{ app.user.prenom }} {{ app.user.nom }}</strong><small>{{ canAdmin ? 'Administration' : (canChef ? 'Chef de chantier' : 'Mon compte') }}</small></span><i class="bi bi-chevron-down" aria-hidden="true"></i>
  </summary><div class="pf-header-popover"><div class="pf-account-heading">{{ app.user.prenom }} {{ app.user.nom }}<small>{{ app.user.email }}</small></div>
   <a href="{{ path('app_account_security') }}"><i class="bi bi-shield-lock" aria-hidden="true"></i>Connexion et sécurité</a>
   <form method="post" action="{{ path('app_logout') }}" data-turbo="false"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button type="submit"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>{{ 'navbar.user.logout'|trans }}</button></form>
  </div></details>
 </div>
</header>
